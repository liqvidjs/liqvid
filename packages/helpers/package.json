{
  "name": "@liqvid/helpers",
  "version": "1.0.0-alpha.3",
  "description": "Convenience components for Liqvid",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/helpers#readme",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "@liqvid/dev": "./src/index.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:tsc": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@radix-ui/react-slot": "catalog:",
    "clsx": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "csstype": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/duration": "workspace:^1.3.0",
    "@liqvid/playback": "workspace:^2.0.0-alpha.0",
    "@liqvid/script": "workspace:^1.0.0-alpha.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.0",
    "react": "catalog:peer"
  }
}
