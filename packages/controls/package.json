{
  "name": "@liqvid/controls",
  "version": "1.0.0-alpha.2",
  "description": "Controls for Liqvid",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "scripts": {
    "build": "pnpm build:clean && mkdir dist && pnpm build:js && pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "tsc",
    "build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "watch": "tsc --watch"
  },
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/controls#readme",
  "dependencies": {
    "clsx": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/color-scheme": "workspace:^1.0.0-alpha.0",
    "@liqvid/duration": "workspace:^1.3.0",
    "@liqvid/keymap": "workspace:^2.0.0-alpha.0",
    "@liqvid/hydration": "workspace:^1.0.0-alpha.2",
    "@liqvid/playback": "workspace:^2.0.0-alpha.0",
    "@liqvid/player": "workspace:^1.0.0-alpha.0",
    "@liqvid/ssr": "workspace:^1.0.0-alpha.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.0",
    "react": "catalog:peer"
  },
  "type": "module"
}
