{
	"name": "@liqvid/recording",
	"version": "1.0.0",
	"description": "Recording functionality for Liqvid",
	"exports": {
		".": {
			"import": "./dist/esm/index.mjs",
			"types": "./dist/types/index.d.mts"
		}
	},
	"typings": "./dist/types/index.d.mts",
	"files": [
		"dist/*"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/liqvidjs/liqvid.git"
	},
	"author": "Yuri Sulyma <yuri@liqvidjs.org>",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/liqvidjs/liqvid/issues"
	},
	"scripts": {
		"build": "pnpm build:clean && mkdir dist && pnpm build:js && pnpm build:css && pnpm build:postclean",
		"build:css": "cp src/style.css dist/esm",
		"build:clean": "rm -rf dist",
		"build:js": "pnpm build:js:esm",
		"build:js:esm": "tsc",
		"build:postclean": "rm dist/tsconfig.tsbuildinfo",
		"lint": "biome check --fix",
		"watch": "tsc --watch"
	},
	"homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/recording#readme",
	"dependencies": {
		"@liqvid/duration": "workspace:^",
		"@liqvid/event-emitter": "workspace:^",
		"@liqvid/hydration": "workspace:^",
		"@liqvid/ssr": "workspace:^",
		"@liqvid/keymap": "catalog:",
		"@liqvid/utils": "workspace:^",
		"@phosphor-icons/react": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"typescript": "catalog:"
	},
	"peerDependencies": {
		"react": "catalog:peer"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	}
}
