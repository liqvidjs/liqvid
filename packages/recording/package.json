{
  "name": "@liqvid/recording",
  "version": "1.0.0-alpha.1",
  "description": "Recording functionality for Liqvid",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/recording#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "@liqvid/dev": "./src/index.ts",
      "import": "./dist/esm/index.js"
    },
    "./utils": {
      "types": "./dist/types/utils.d.ts",
      "@liqvid/dev": "./src/utils.ts",
      "import": "./dist/esm/utils.js"
    }
  },
  "scripts": {
    "build": "pnpm build:clean && mkdir dist && pnpm build:js && pnpm build:css && pnpm build:postclean",
    "build:css": "cp src/style.css dist/esm",
    "build:clean": "rm -rf dist",
    "build:js": "pnpm build:js:esm",
    "build:js:esm": "tsc",
    "build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:package": "../../format-package-json.sh",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/duration": "workspace:^1.3.0",
    "@liqvid/event-emitter": "workspace:^1.0.0-alpha.0",
    "@liqvid/hydration": "workspace:^1.0.0-alpha.0",
    "@liqvid/keymap": "workspace:^2.0.0-alpha.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.0",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "type": "module"
}
