{
  "name": "@liqvid/animation",
  "version": "1.0.0-alpha.0",
  "description": "Animation utilities for Liqvid",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/animation#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid",
    "directory": "packages/animation"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:package": "../../format-package-json.sh",
    "lint:tsc": "tsc --noEmit",
    "test": "jest --coverage",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "bezier-easing": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/jest": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "jest": "catalog:dev",
    "ts-jest": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/duration": "workspace:^1.3.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.0"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/types/index.d.ts"
}
