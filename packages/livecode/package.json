{
  "name": "@lqv/livecode",
  "version": "1.0.0-alpha.0",
  "description": "GUI for interactive coding tutorials with CodeMirror",
  "homepage": "https://github.com/liqvidjs/plugins/tree/main/packages/livecode",
  "bugs": {
    "url": "https://github.com/liqvidjs/plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/plugins.git",
    "directory": "packages/livecode"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "@liqvid/dev": "./src/index.ts",
      "import": "./dist/esm/index.js"
    },
    "./interpreters/*": {
      "types": "./dist/types/interpreters/*.d.ts",
      "@liqvid/dev": "./src/interpreters/*.ts",
      "import": "./dist/esm/interpreters/*.js"
    },
    "./style.css": "./dist/css/style.css",
    "./web": {
      "types": "./dist/types/presets/web/index.d.ts",
      "@liqvid/dev": "./src/presets/web/index.ts",
      "import": "./dist/esm/presets/web/index.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:package": "../../format-package-json.sh",
    "lint:tsc": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "clsx": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@codemirror/autocomplete": "catalog:dev",
    "@codemirror/commands": "catalog:dev",
    "@codemirror/lang-css": "catalog:dev",
    "@codemirror/lang-html": "catalog:dev",
    "@codemirror/lang-javascript": "catalog:dev",
    "@codemirror/lang-python": "catalog:dev",
    "@codemirror/language": "catalog:dev",
    "@codemirror/lint": "catalog:dev",
    "@codemirror/search": "catalog:dev",
    "@codemirror/state": "catalog:dev",
    "@codemirror/view": "catalog:dev",
    "@lqv/codemirror": "workspace:^",
    "@types/babel__standalone": "catalog:dev",
    "@types/react": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "glslx": "catalog:dev",
    "jszip": "catalog:peer",
    "prettier": "catalog:peer",
    "prettier-plugin-glsl": "catalog:peer",
    "skulpt": "catalog:dev",
    "type-fest": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@babel/standalone": "catalog:peer",
    "@codemirror/autocomplete": "catalog:peer",
    "@codemirror/commands": "catalog:peer",
    "@codemirror/lang-css": "catalog:peer",
    "@codemirror/lang-html": "catalog:peer",
    "@codemirror/lang-javascript": "catalog:peer",
    "@codemirror/lang-python": "catalog:peer",
    "@codemirror/language": "catalog:peer",
    "@codemirror/lint": "catalog:peer",
    "@codemirror/search": "catalog:peer",
    "@codemirror/state": "catalog:peer",
    "@codemirror/view": "catalog:peer",
    "@liqvid/color-scheme": "workspace:^1.0.0-alpha.2",
    "@liqvid/duration": "workspace:^1.3.0",
    "@liqvid/event-emitter": "workspace:^1.0.0-alpha.0",
    "@liqvid/fp": "workspace:^1.0.0-alpha.0",
    "@liqvid/hydration": "workspace:^1.0.0-alpha.4",
    "@liqvid/keymap": "workspace:^2.0.0-alpha.1",
    "@liqvid/recording": "workspace:^1.0.0-alpha.1",
    "@liqvid/studio-plugin-api": "workspace:^1.0.0-alpha.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.4",
    "@lqv/codemirror": "workspace:^1.0.0-alpha.0",
    "@lqv/playback": "workspace:^1.0.0-alpha.0",
    "@replit/codemirror-vim": "catalog:peer",
    "effect": "catalog:peer",
    "glslx": "catalog:peer",
    "jszip": "catalog:peer",
    "prettier": "catalog:peer",
    "prettier-plugin-glsl": "catalog:peer",
    "react": "catalog:peer",
    "skulpt": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@babel/standalone": {
      "optional": true
    },
    "@codemirror/lang-css": {
      "optional": true
    },
    "@codemirror/lang-html": {
      "optional": true
    },
    "@codemirror/lang-javascript": {
      "optional": true
    },
    "@codemirror/lang-python": {
      "optional": true
    },
    "@codemirror/lang-sql": {
      "optional": true
    },
    "glslx": {
      "optional": true
    },
    "jszip": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "prettier-plugin-glsl": {
      "optional": true
    },
    "skulpt": {
      "optional": true
    }
  }
}
