{
  "name": "@lqv/codemirror",
  "version": "1.0.0-alpha.0",
  "description": "Codemirror 6 recording and replaying",
  "keywords": [
    "liqvid",
    "@liqvid/recording",
    "codemirror"
  ],
  "homepage": "https://github.com/liqvidjs/plugins/tree/main/packages/codemirror",
  "bugs": {
    "url": "https://github.com/liqvidjs/plugins/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/plugins.git"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "@liqvid/dev": "./src/index.ts",
      "import": "./dist/esm/index.js"
    },
    "./extensions": {
      "types": "./dist/types/extensions.d.ts",
      "@liqvid/dev": "./src/extensions.ts",
      "import": "./dist/esm/extensions.js"
    },
    "./fake-selection": {
      "types": "./dist/types/fake-selection.d.ts",
      "@liqvid/dev": "./src/fake-selection.ts",
      "import": "./dist/esm/fake-selection.js"
    },
    "./liqvid-studio-server-plugin": {
      "types": "./dist/types/liqvid-studio-server-plugin.d.mts",
      "@liqvid/dev": "./src/liqvid-studio-server-plugin.mts",
      "import": "./dist/esm/liqvid-studio-server-plugin.mjs"
    },
    "./recording": {
      "types": "./dist/types/recording.d.ts",
      "@liqvid/dev": "./src/recording.tsx",
      "import": "./dist/esm/recording.js",
      "require": "./dist/cjs/recording.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "pnpm biome check --fix",
    "lint:package": "../../format-package-json.sh",
    "lint:tsc": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@liqvid/utils": "workspace:^2.0.0-alpha.3"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@codemirror/state": "catalog:dev",
    "@codemirror/view": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "effect": "catalog:dev",
    "effect-paths": "workspace:^",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@codemirror/state": "catalog:peer",
    "@codemirror/view": "catalog:peer",
    "@liqvid/keymap": "workspace:^2.0.0-alpha.1",
    "@liqvid/recording": "workspace:^1.0.0-alpha.1",
    "@liqvid/studio-plugin-api": "workspace:^1.0.0-alpha.0",
    "@lqv/playback": "workspace:^1.0.0-alpha.0",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@liqvid/keymap": {
      "optional": true
    },
    "@liqvid/recording": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
