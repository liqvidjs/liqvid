{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "domains": {
      "next": "recommended",
      "react": "recommended"
    },
    "enabled": true,
    "rules": {
      "correctness": {
        "noPrivateImports": "error"
      },
      "recommended": true,

      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@liqvid/prompts": {
                "importNames": ["Cue", "Prompt"],
                "message": "import the styled versions from @/components/liqvid/prompts"
              }
            }
          }
        }
      }
    }
  },
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
