{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": false,
    "strict": true,
    "target": "es2019",
    "types": ["node"]
  },
  "exclude": ["templates", "dist"],
  "include": ["src/*"]
}
