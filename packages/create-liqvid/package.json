{
  "name": "create-liqvid",
  "version": "1.0.0-alpha.3",
  "keywords": [
    "liqvid",
    "react",
    "next",
    "next.js"
  ],
  "description": "Create Liqvid projects with one command",
  "repository": {
    "type": "git",
    "url": "https://github.com/liqvidjs/liqvid",
    "directory": "packages/create-liqvid"
  },
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "license": "MIT",
  "bin": {
    "create-liqvid": "./dist/index.mts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "ncc build ./src/index.mts -o ./dist/ --minify --no-cache --no-source-map-register",
    "dev": "ncc build ./src/index.mts -w -o dist/",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "prebuild": "rm -rf dist",
    "prepublishOnly": "cp -R templates dist; rm dist/templates/replicate; cp -R presets dist/templates/presets",
    "versions": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/versions.mts versions.json",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/async-retry": "1.4.9",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "catalog:dev",
    "@types/prompts": "2.4.9",
    "@types/validate-npm-package-name": "4.0.2",
    "@vercel/ncc": "0.38.4",
    "async-retry": "1.3.3",
    "async-sema": "^3.1.1",
    "ci-info": "4.4.0",
    "commander": "14.0.3",
    "conf": "15.1.0",
    "cross-spawn": "7.0.6",
    "effect-paths": "workspace:^",
    "fast-glob": "3.3.3",
    "picocolors": "1.1.1",
    "prettier-plugin-tailwindcss": "0.7.2",
    "prompts": "2.4.2",
    "tar": "7.5.11",
    "typescript": "catalog:dev",
    "update-check": "1.5.4",
    "validate-npm-package-name": "7.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "type": "module"
}
