{
  "name": "@liqvid/renderer",
  "version": "2.0.0-alpha.1",
  "description": "Audio utilities, static video rendering, and thumbnail generation for Liqvid",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/renderer#readme",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/tasks/index.d.mts",
      "@liqvid/dev": "./src/index.mts",
      "import": "./dist/esm/index.mjs"
    },
    "./convert": {
      "types": "./dist/types/tasks/convert.d.mts",
      "@liqvid/dev": "./src/tasks/convert.mts",
      "import": "./dist/esm/tasks/convert.mjs"
    },
    "./debug": {
      "types": "./dist/types/tasks/debug.d.mts",
      "@liqvid/dev": "./src/tasks/debug.mts",
      "import": "./dist/esm/tasks/debug.mjs"
    },
    "./join": {
      "types": "./dist/types/tasks/join.d.mts",
      "@liqvid/dev": "./src/tasks/join.mts",
      "import": "./dist/esm/tasks/join.mjs"
    },
    "./render-audio": {
      "types": "./dist/types/tasks/render-audio.d.mts",
      "@liqvid/dev": "./src/tasks/render-audio.mts",
      "import": "./dist/esm/tasks/render-audio.mjs"
    },
    "./screenshot": {
      "types": "./dist/types/tasks/screenshot.d.mts",
      "@liqvid/dev": "./src/tasks/screenshot.mts",
      "import": "./dist/esm/tasks/screenshot.mjs"
    },
    "./solidify": {
      "types": "./dist/types/tasks/solidify.d.mts",
      "@liqvid/dev": "./src/tasks/solidify.mts",
      "import": "./dist/esm/tasks/solidify.mjs"
    },
    "./thumbs": {
      "types": "./dist/types/tasks/thumbs.d.mts",
      "@liqvid/dev": "./src/tasks/thumbs.mts",
      "import": "./dist/esm/tasks/thumbs.mjs"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:package": "../../format-package-json.sh",
    "lint:tsc": "tsc --noEmit",
    "test": "jest --coverage",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@liqvid/utils": "workspace:^2.0.0-alpha.3",
    "@puppeteer/browsers": "catalog:",
    "cli-progress": "catalog:",
    "effect": "catalog:",
    "execa": "catalog:",
    "jimp": "catalog:",
    "puppeteer-core": "catalog:",
    "yargs-parser": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@effect/language-service": "catalog:dev",
    "@effect/tsgo": "catalog:dev",
    "@types/cli-progress": "catalog:dev",
    "@types/yargs-parser": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "effect-paths": "workspace:^"
  }
}
