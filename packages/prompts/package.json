  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:package": "../../format-package-json.sh",
    "lint:tsc": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "clsx": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/hydration": "workspace:^1.0.0-alpha.4",
    "@liqvid/keymap": "workspace:^2.0.0-alpha.0",
    "@liqvid/script": "workspace:^1.0.0-alpha.0",
    "@liqvid/studio-plugin-api": "workspace:^1.0.0-alpha.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.0"
  },
  "sideEffects": false,
  "type": "module"
}
