{
  "name": "@liqvid/script",
  "version": "1.0.0-alpha.2",
  "description": "Script class for Liqvid",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/script#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.mts",
      "types": "./dist/types/index.d.mts",
      "import": "./dist/esm/index.mjs"
    },
    "./react": {
      "@liqvid/dev": "./src/react.mts",
      "types": "./dist/types/react.d.mts",
      "import": "./dist/esm/react.mjs"
    },
    "./recording": {
      "@liqvid/dev": "./src/recording.tsx",
      "types": "./dist/types/recording.d.ts",
      "import": "./dist/esm/recording.js"
    },
    "./liqvid-studio-server-plugin": {
      "@liqvid/dev": "./src/liqvid-studio-server-plugin.mts",
      "types": "./dist/types/liqvid-studio-server-plugin.d.mts",
      "import": "./dist/esm/liqvid-studio-server-plugin.mjs"
    }
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:js && pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "tsc",
    "build:postclean": "find . -name tsconfig.tsbuildinfo -delete",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "pnpm biome check --fix",
    "lint:package": "../../format-package-json.sh",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@radix-ui/react-slot": "catalog:",
    "clsx": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@liqvid/keymap": "workspace:^2.0.0-alpha.0",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "effect": "catalog:dev",
    "effect-paths": "workspace:^",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/duration": "workspace:^1.3.0",
    "@liqvid/event-emitter": "workspace:^1.0.0-alpha.0",
    "@liqvid/keymap": "workspace:^2.0.0-alpha.0",
    "@liqvid/playback": "workspace:^2.0.0-alpha.0",
    "@liqvid/recording": "workspace:^1.0.0-alpha.0",
    "@liqvid/studio-plugin-api": "workspace:^1.0.0-alpha.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.0",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "type": "module",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/types/*"
      ]
    }
  }
}
