{
  "name": "@liqvid/hydration",
  "version": "1.0.0-alpha.4",
  "description": "Use client-only values in React without encountering hydration errors. Especially useful for statically generated sites.",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/hydration#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git",
    "directory": "packages/hydration"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:clean; pnpm build:js; pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "tsc",
    "build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:package": "../../format-package-json.sh",
    "lint:tsc": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@radix-ui/react-slot": "catalog:",
    "universal-cookie": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/ssr": "workspace:^1.0.0-alpha.0",
    "react": "catalog:peer"
  },
  "sideEffects": false,
  "type": "module",
  "types": "dist/types/index.d.ts"
}
