{
  "name": "@liqvid/color-scheme",
  "version": "1.0.0-alpha.4",
  "description": "Color scheme helpers for Liqvid",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/color-scheme#readme",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git",
    "directory": "packages/color-scheme"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./docusaurus": {
      "types": "./dist/types/docusaurus.d.ts",
      "@liqvid/dev": "./src/docusaurus.tsx",
      "import": "./dist/esm/docusaurus.js"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "@liqvid/dev": "./src/react.tsx",
      "import": "./dist/esm/react.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "find ./dist -name tsconfig.tsbuildinfo -delete",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:tsc": "tsc --noEmit",
    "test": "jest",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@docusaurus/types": "catalog:dev",
    "@types/react": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@docusaurus/theme-common": "catalog:dev",
    "@liqvid/hydration": "workspace:^1.0.0-alpha.4",
    "@liqvid/ssr": "workspace:^1.0.0-alpha.1",
    "@liqvid/utils": "workspace:^2.0.0-alpha.4",
    "@types/react": "catalog:peer",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@docusaurus/theme-common": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
