{
  "name": "@liqvid/fp",
  "version": "1.0.0-alpha.1",
  "description": "A functional programming library",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "files": [
    "./dist/*"
  ],
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.mts",
      "types": "./dist/types/index.d.mts",
      "import": "./dist/esm/index.mjs"
    },
    "./zod": {
      "@liqvid/dev": "./src/integrations/zod.mts",
      "types": "./dist/types/integrations/zod.d.mts",
      "import": "./dist/esm/integrations/zod.mjs"
    }
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:js && pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "pnpm build:js:esm; pnpm build:js:cjs",
    "build:js:cjs": "tsc --module commonjs --moduleResolution node --outDir dist/cjs --customConditions null --verbatimModuleSyntax false",
    "build:js:esm": "tsc",
    "build:postclean": "find ./dist -name tsconfig.tsbuildinfo -delete",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:package": "../../format-package-json.sh",
    "test": "jest",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/ssr": "workspace:^1.0.0-alpha.1",
    "zod": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "type": "module",
  "module": "./dist/index.mjs"
}
