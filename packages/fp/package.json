{
  "name": "@liqvid/fp",
  "version": "1.0.0-alpha.1",
  "description": "A functional programming library",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "type": "module",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.mts",
      "types": "./dist/types/index.d.mts",
      "import": "./dist/esm/index.mjs"
    },
    "./zod": {
      "@liqvid/dev": "./src/integrations/zod.mts",
      "types": "./dist/types/integrations/zod.d.mts",
      "import": "./dist/esm/integrations/zod.mjs"
    }
  },
  "module": "./dist/index.mjs",
  "files": [
    "./dist/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "find ./dist -name tsconfig.tsbuildinfo -delete",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:tsc": "tsc --noEmit",
    "test": "jest",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/ssr": "workspace:^1.0.0-alpha.1",
    "zod": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  }
}
