{
  "name": "@liqvid/iframe-api",
  "version": "1.0.0-alpha.1",
  "description": "Cross-iframe communication API",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts"
    },
    "./child": {
      "@liqvid/dev": "./src/child.ts",
      "import": "./dist/esm/child.js",
      "types": "./dist/types/child.d.ts"
    },
    "./parent": {
      "@liqvid/dev": "./src/parent.ts",
      "import": "./dist/esm/parent.js",
      "types": "./dist/types/parent.d.ts"
    },
    "./parent/react": {
      "@liqvid/dev": "./src/react.ts",
      "import": "./dist/esm/react.js",
      "types": "./dist/types/react.d.ts"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "pnpm build:clean && pnpm build:js && pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "tsc",
    "build:postclean": "find ./dist -name tsconfig.tsbuildinfo -delete",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "test": "jest",
    "watch": "tsc --watch"
  },
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/iframe-api#readme",
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/react": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@types/react": "catalog:peer",
    "effect": "catalog:peer",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "effect": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "type": "module"
}
