{
  "name": "@liqvid/katex",
  "version": "1.0.0-alpha.0",
  "description": "KaTeX integration for Liqvid",
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/types/*.d.ts"
      ]
    }
  },
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "keywords": [
    "liqvid",
    "katex"
  ],
  "scripts": {
    "build": "pnpm build:clean && pnpm build:js && pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "pnpm build:js:esm; pnpm build:js:cjs",
    "build:js:esm": "tsc",
    "build:js:cjs": "tsc --module commonjs --moduleResolution node --outDir dist/cjs --customConditions null --verbatimModuleSyntax false",
    "build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/katex",
  "license": "MIT",
  "dependencies": {
    "@radix-ui/react-slot": "catalog:",
    "@liqvid/utils": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@liqvid/player": "workspace:^",
    "@types/react": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "katex": "catalog:peer",
    "@liqvid/player": "workspace:^1.0.0-alpha.0",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@liqvid/player": {
      "optional": true
    }
  },
  "sideEffects": false,
  "type": "module"
}
