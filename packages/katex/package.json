{
  "name": "@liqvid/katex",
  "version": "1.0.0-alpha.1",
  "description": "KaTeX integration for Liqvid",
  "keywords": [
    "liqvid",
    "katex"
  ],
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/katex",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    ".build:cjs": "tsc --module commonjs --outDir dist/cjs --verbatimModuleSyntax false",
    ".build:clean": "rm -rf dist",
    ".build:esm": "tsc",
    ".build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "build": "pnpm .build:esm && pnpm .build:cjs",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:tsc": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@liqvid/utils": "workspace:^2.0.0-alpha.6",
    "@radix-ui/react-slot": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@liqvid/player": "workspace:^",
    "@types/jest": "catalog:dev",
    "@types/katex": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "jest": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "katex": "catalog:peer",
    "react": "catalog:peer"
  }
}
