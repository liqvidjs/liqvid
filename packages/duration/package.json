{
  "name": "@liqvid/duration",
  "version": "1.4.0",
  "description": "Class for unitless time intervals",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./effect": {
      "@liqvid/dev": "./src/effect.ts",
      "import": "./dist/esm/effect.js",
      "types": "./dist/types/effect.d.ts"
    },
    "./zod": {
      "@liqvid/dev": "./src/zod.ts",
      "import": "./dist/esm/zod.js",
      "types": "./dist/types/zod.d.ts"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "pnpm build:clean; pnpm build:js; pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "pnpm build:js:esm; pnpm build:js:cjs",
    "build:js:cjs": "tsc --project tsconfig.cjs.json",
    "build:js:esm": "tsc",
    "build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/duration#readme",
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/ssr": "workspace:^1.0.0-alpha.1",
    "effect": "catalog:peer",
    "zod": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "sideEffects": false,
  "type": "module"
}
