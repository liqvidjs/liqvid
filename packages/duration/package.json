{
  "name": "@liqvid/duration",
  "version": "1.4.1",
  "description": "Class for unitless time intervals",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/duration#readme",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./effect": {
      "@liqvid/dev": "./src/effect.ts",
      "types": "./dist/types/effect.d.ts",
      "import": "./dist/esm/effect.js"
    },
    "./zod": {
      "@liqvid/dev": "./src/zod.ts",
      "types": "./dist/types/zod.d.ts",
      "import": "./dist/esm/zod.js"
    }
  },
  "types": "dist/types/index.d.ts",
  "files": [
    "dist/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:tsc": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/node": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "effect": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/ssr": "workspace:^1.0.0-alpha.3",
    "effect": "catalog:peer",
    "zod": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  }
}
