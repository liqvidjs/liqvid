{
  "name": "effect-paths",
  "version": "0.0.1",
  "description": "Effect helpers adding type safety for dealing with absolute vs relative and file vs directory",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/v3/packages/effect-paths#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git",
    "directory": "packages/effect-paths"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:js && pnpm build:dts",
    ".build:clean": "rm -rf dist",
    "build:dts": "pnpm build:dts:copy && pnpm build:dts:rm",
    "build:dts:copy": "cp src/*.d.ts dist/types",
    "build:dts:rm": "sed -i '' -E '/import .*\\.d\\.ts.*;$/d' dist/esm/index.js",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "build:js": "tsc",
    ".build:postclean": "find ./dist -name tsconfig.tsbuildinfo -delete",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "test": "tsc --noEmit --project tsconfig.test.json",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@effect/language-service": "catalog:dev",
    "@effect/tsgo": "catalog:dev",
    "@types/node": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "effect": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "effect": "catalog:peer"
  },
  "sideEffects": false,
  "type": "module",
  "types": "dist/types/index.d.ts"
}
