{
  "name": "@liqvid/cli",
  "version": "2.0.0-alpha.3",
  "description": "Liqvid command line utility",
  "main": "dist/esm/index.mjs",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.mts",
      "import": "./dist/esm/index.mjs",
      "types": "./dist/types/index.d.mts"
    },
    "./build": {
      "@liqvid/dev": "./src/tasks/build.mts",
      "import": "./dist/esm/tasks/build.mjs",
      "types": "./dist/types/tasks/build.d.mts"
    },
    "./render": {
      "@liqvid/dev": "./src/tasks/render.mts",
      "import": "./dist/esm/tasks/render.mjs",
      "types": "./dist/types/tasks/render.d.mts"
    },
    "./thumbs": {
      "@liqvid/dev": "./src/tasks/thumbs.mts",
      "import": "./dist/esm/tasks/thumbs.mjs",
      "types": "./dist/types/tasks/thumbs.d.mts"
    },
    "./transcribe": {
      "@liqvid/dev": "./src/tasks/transcribe.mts",
      "import": "./dist/esm/tasks/transcribe.mjs",
      "types": "./dist/types/tasks/transcribe.d.mts"
    }
  },
  "bin": {
    "liqvid": "liqvid-cli.mjs"
  },
  "files": [
    "dist/*",
    "liqvid-cli.mjs",
    "templates/*"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "homepage": "https://github.com/liqvidjs/liqvid#readme",
  "scripts": {
    "build": "tsc --build",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "test": "jest --coverage",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/credential-providers": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@liqvid/duration": "workspace:^1.4.0",
    "@liqvid/renderer": "workspace:^2.0.0-alpha.1",
    "@liqvid/schemas": "workspace:^",
    "@liqvid/utils": "workspace:^2.0.0-alpha.3",
    "@types/node": "catalog:",
    "chalk": "catalog:",
    "cli-progress": "catalog:",
    "execa": "catalog:",
    "fast-glob": "catalog:",
    "handlebars": "catalog:",
    "nodejs-whisper": "catalog:peer",
    "pluralize": "catalog:",
    "yargs": "catalog:",
    "yargs-parser": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/cli-progress": "catalog:dev",
    "@types/pluralize": "catalog:",
    "@types/yargs": "catalog:dev",
    "nodejs-whisper": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "nodejs-whisper": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "nodejs-whisper": {
      "optional": true
    }
  }
}
