{
  "name": "@liqvid/cli",
  "version": "2.0.0-alpha.3",
  "description": "Liqvid command line utility",
  "homepage": "https://github.com/liqvidjs/liqvid#readme",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.mts",
      "types": "./dist/types/index.d.mts",
      "import": "./dist/esm/index.mjs"
    },
    "./build": {
      "@liqvid/dev": "./src/tasks/build.mts",
      "types": "./dist/types/tasks/build.d.mts",
      "import": "./dist/esm/tasks/build.mjs"
    },
    "./compress": {
      "@liqvid/dev": "./src/tasks/compress.mts",
      "types": "./dist/types/tasks/compress.d.mts",
      "import": "./dist/esm/tasks/compress.mjs"
    },
    "./debug": {
      "@liqvid/dev": "./src/tasks/debug.mts",
      "types": "./dist/types/tasks/debug.d.mts",
      "import": "./dist/esm/tasks/debug.mjs"
    },
    "./publish": {
      "@liqvid/dev": "./src/tasks/publish.mts",
      "types": "./dist/types/tasks/publish.d.mts",
      "import": "./dist/esm/tasks/publish.mjs"
    },
    "./render": {
      "@liqvid/dev": "./src/tasks/render.mts",
      "types": "./dist/types/tasks/render.d.mts",
      "import": "./dist/esm/tasks/render.mjs"
    },
    "./render-audio": {
      "@liqvid/dev": "./src/tasks/render-audio.mts",
      "types": "./dist/types/tasks/render-audio.d.mts",
      "import": "./dist/esm/tasks/render-audio.mjs"
    },
    "./thumbs": {
      "@liqvid/dev": "./src/tasks/thumbs.mts",
      "types": "./dist/types/tasks/thumbs.d.mts",
      "import": "./dist/esm/tasks/thumbs.mjs"
    },
    "./screenshot": {
      "@liqvid/dev": "./src/tasks/screenshot.mts",
      "types": "./dist/types/tasks/screenshot.d.mts",
      "import": "./dist/esm/tasks/screenshot.mjs"
    },
    "./transcribe": {
      "@liqvid/dev": "./src/tasks/transcribe.mts",
      "types": "./dist/types/tasks/transcribe.d.mts",
      "import": "./dist/esm/tasks/transcribe.mjs"
    },
    "./utils": {
      "@liqvid/dev": "./src/utils.mts",
      "types": "./dist/types/utils.d.mts",
      "import": "./dist/esm/utils.mjs"
    }
  },
  "main": "dist/esm/index.mjs",
  "bin": {
    "liqvid": "liqvid-cli.mjs"
  },
  "files": [
    "dist/*",
    "liqvid-cli.mjs",
    "templates/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:tsc": "tsc --noEmit",
    "test": "jest --coverage",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/credential-providers": "catalog:",
    "@aws-sdk/lib-storage": "catalog:",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@liqvid/duration": "workspace:^1.4.0",
    "@liqvid/fp": "workspace:^1.0.0-alpha.0",
    "@liqvid/renderer": "workspace:^2.0.0-alpha.1",
    "@liqvid/schemas": "workspace:^",
    "@liqvid/utils": "workspace:^2.0.0-alpha.4",
    "@types/node": "catalog:dev",
    "chalk": "catalog:",
    "cli-progress": "catalog:",
    "effect": "catalog:",
    "execa": "catalog:",
    "fast-glob": "catalog:",
    "handlebars": "catalog:",
    "pluralize": "catalog:",
    "sharp": "catalog:",
    "yargs": "catalog:",
    "yargs-parser": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@effect/language-service": "catalog:dev",
    "@effect/tsgo": "catalog:dev",
    "@types/cli-progress": "catalog:dev",
    "@types/pluralize": "catalog:",
    "@types/yargs": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "effect-paths": "workspace:^",
    "smart-whisper": "catalog:peer"
  }
}
