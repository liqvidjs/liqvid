{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "media": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "const": "s3",
          "type": "string"
        },
        "s3": {
          "additionalProperties": false,
          "properties": {
            "auth": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "profile": {
                      "type": "string"
                    }
                  },
                  "required": ["profile"],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "cloudflareR2": {
                      "additionalProperties": false,
                      "properties": {
                        "accountId": {
                          "default": "{env:CLOUDFLARE_ACCOUNT_ID}",
                          "pattern": "^\\{env:[\\s\\S]{0,}\\}$",
                          "type": "string"
                        },
                        "apiToken": {
                          "default": "{env:CLOUDFLARE_API_TOKEN}",
                          "pattern": "^\\{env:[\\s\\S]{0,}\\}$",
                          "type": "string"
                        }
                      },
                      "required": ["accountId", "apiToken"],
                      "type": "object"
                    }
                  },
                  "type": "object"
                }
              ]
            },
            "bucket": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "region": {
              "type": "string"
            }
          },
          "required": ["auth", "bucket"],
          "type": "object"
        }
      },
      "required": ["provider", "s3"],
      "type": "object"
    }
  },
  "required": ["media"],
  "type": "object"
}
