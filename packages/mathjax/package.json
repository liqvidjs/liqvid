{
  "name": "@liqvid/mathjax",
  "version": "1.0.0-alpha.0",
  "description": "MathJax integration for Liqvid",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./plain": {
      "@liqvid/dev": "./src/plain.tsx",
      "import": "./dist/esm/plain.js",
      "types": "./dist/types/plain.d.ts"
    }
  },
  "files": [
    "dist/*"
  ],
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "keywords": [
    "liqvid",
    "mathjax"
  ],
  "scripts": {
    "build": "pnpm build:clean && pnpm build:js && pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "tsc",
    "build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/mathjax",
  "license": "MIT",
  "dependencies": {
    "@liqvid/utils": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@liqvid/player": "workspace:^",
    "@types/node": "catalog:",
    "@types/react": "catalog:dev",
    "mathjax": "^3.2.0",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/event-emitter": "workspace:^1.0.0-alpha.0",
    "@liqvid/player": "workspace:^1.0.0-alpha.0",
    "mathjax": "catalog:peer",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "liqvid": {
      "optional": true
    },
    "mathjax": {
      "optional": true
    }
  },
  "sideEffects": false,
  "type": "module"
}
