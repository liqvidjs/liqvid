{
  "name": "@liqvid/react-three",
  "version": "3.0.0-alpha.0",
  "description": "@react-three integration for Liqvid",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/react-three",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "@liqvid/dev": "./src/index.tsx",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "test": "echo \"Error: no test specified\" && exit 1",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/three": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@juggle/resize-observer": "catalog:peer",
    "@react-three/fiber": "catalog:peer",
    "react": "catalog:peer"
  }
}
