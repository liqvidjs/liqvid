{
  "compilerOptions": {
    "alwaysStrict": true,
    "declaration": true,
    "declarationDir": "./dist/types",
    "esModuleInterop": true,
    "incremental": true,
    "jsx": "react",
    "lib": ["esnext", "dom"],
    "noImplicitAny": true,
    "outDir": "./dist/esm",
    "pretty": true,
    "removeComments": false,
    "rootDir": "./src",
    "target": "esnext"
  },
  "extends": "../../tsconfig.json",
  "include": ["./src"]
}
