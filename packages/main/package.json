{
  "name": "liqvid",
  "version": "3.0.0-alpha.5",
  "description": "Framework for interactive videos in React",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/main#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    },
    "./dist/liqvid.css": "./dist/liqvid.css",
    "./dist/liqvid.min.css": "./dist/liqvid.min.css",
    "./liqvid.css": "./dist/liqvid.css",
    "./liqvid.min.css": "./dist/liqvid.min.css"
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:css && pnpm build:js",
    "build:clean": "rm -rf dist",
    "build:css": "stylus -o dist/liqvid.css styl/liqvid.styl; stylus -c -o dist/liqvid.min.css styl/liqvid.styl",
    "build:js": "pnpm build:js:bundle;  pnpm build:js:esm",
    "build:js:bundle": "tsc && rollup -c && rm -rf dist/esm",
    "build:js:esm": "tsc --module esnext --outDir dist/esm",
    "lint": "biome check --fix",
    "lint:package": "../../format-package-json.sh",
    "stylus": "stylus -o dist/liqvid.css -w styl/liqvid.styl",
    "stylus:prod": "stylus -c -o dist/liqvid.min.css -w styl/liqvid.styl",
    "test": "pnpm test:jest && pnpm test:build-e2e && pnpm test:playwright",
    "test:build-e2e": "cd e2e/app && pnpm build && cd ../..",
    "test:jest": "jest",
    "test:playwright": "npx playwright test",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/jest": "catalog:dev",
    "@types/react": "catalog:dev",
    "jest": "catalog:dev",
    "nib": "catalog:dev",
    "stylus": "catalog:dev",
    "ts-jest": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/animation": "workspace:^1.0.0-alpha.0",
    "@liqvid/color-scheme": "workspace:^1.0.0-alpha.2",
    "@liqvid/controls": "workspace:^1.0.0-alpha.1",
    "@liqvid/duration": "workspace:^1.3.0",
    "@liqvid/event-emitter": "workspace:^1.0.0-alpha.0",
    "@liqvid/helpers": "workspace:^1.0.0-alpha.2",
    "@liqvid/hydration": "workspace:^1.0.0-alpha.2",
    "@liqvid/keymap": "workspace:^2.0.0-alpha.0",
    "@liqvid/media": "workspace:^1.0.0-alpha.1",
    "@liqvid/playback": "workspace:^2.0.0-alpha.1",
    "@liqvid/player": "workspace:^1.0.0-alpha.1",
    "@liqvid/script": "workspace:^1.0.0-alpha.1",
    "@liqvid/ssr": "workspace:^1.0.0-alpha.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.2",
    "@types/react": "catalog:peer",
    "@types/react-dom": "catalog:peer",
    "react": "catalog:peer",
    "react-dom": "catalog:peer"
  },
  "sideEffects": false,
  "type": "module"
}
