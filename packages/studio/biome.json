{
  "extends": ["../../biome.json"],
  "linter": {
    "rules": {
      "a11y": {
        "noLabelWithoutControl": {
          "level": "on",
          "options": {
            "inputComponents": ["Checkbox", "RadioRoot", "SelectRoot", "Switch"]
          }
        }
      },
      "correctness": {
        "noNextAsyncClientComponent": "on",
        "noRestrictedElements": {
          "level": "on",
          "options": {
            "elements": {
              "button": "use the styled version from #_/ui/Button.tsx",
              "input": "use the styled version from #_/ui/TextField.tsx (text), #_/ui/Checkbox.tsx (checkbox), or #_/ui/Radio.tsx (radio)",
              "select": "use the styled version from #_/ui/Select.tsx"
            }
          }
        }
      },
      "style": {
        "noJsxLiterals": "error",

        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@base-ui/react/alert-dialog": "import styled versions from \"#_/ui/AlertDialog.js\"",
              "@base-ui/react/checkbox": "import styled versions from \"#_/ui/Checkbox.js\"",
              "@base-ui/react/dialog": "import styled versions from \"#_/ui/Dialog.js\"",
              "@base-ui/react/navigation-menu": "import styled versions from \"#_/ui/NavigationMenu.js\"",
              "@base-ui/react/radio": "import styled versions from \"#_/ui/Radio.js\"",
              "@base-ui/react/select": "import styled versions from \"#_/ui/Select.js\"",
              "@phosphor-icons/react": {
                "importNames": ["SpinnerIcon"],
                "message": "import the Spinner component from \"#_/components/Spinner.js\""
              },
              "react-headings": "import SSR-safe versions from \"#_/ui/headings.js\""
            }
          }
        }
      },
      "suspicious": {
        "noConsole": {
          "level": "on",
          "options": {
            "allow": ["assert", "error", "info", "warn"]
          }
        }
      }
    }
  },
  "root": false
}
