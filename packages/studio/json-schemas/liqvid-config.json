{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "backend": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "enum": ["githubPages", "liqvidStudio", "s3", "sftp"],
          "type": "string"
        },
        "media": {
          "enum": ["liqvidStudio", "s3", "sftp"],
          "type": "string"
        }
      },
      "required": ["content", "media"],
      "type": "object"
    },
    "providers": {
      "additionalProperties": false,
      "properties": {
        "bluesky": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "facebook": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "githubPages": {
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "root": {
              "type": "boolean"
            },
            "username": {
              "type": "string"
            }
          },
          "required": ["repository", "username"],
          "type": "object"
        },
        "instagram": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "liqvidStudio": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "s3": {
          "additionalProperties": false,
          "properties": {
            "bucket": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            }
          },
          "required": ["bucket"],
          "type": "object"
        },
        "sftp": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": ["host", "path"],
          "type": "object"
        },
        "twitter": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "youtube": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": ["$schema", "backend", "providers"],
  "type": "object"
}
