/**
 * @file This file contains various helpers with type safety for
 * the markers and directory structure of this particular project.
 */

import { DirectoryHelper } from "@liqvid/studio";
import { Animate, TargetDescendants, UniversalHelper } from "liqvid";
import { usePathname } from "next/navigation";

import type { ProjectDir } from "../.liqvid/types.ts";

import { type M, script } from "./markers.ts";

import projectPath from "../.liqvid/project-path.json" with { type: "json" };

/* -------------------- helper components -------------------- */

/**
 * @access parent
 * General-purpose helper component for:
 * - creating `<Segment>`s, when passed `during`, `from`, or `to`
 * - positioning, when passed `b`ottom, `r`ight `x` (= left), or `y` (= top)
 * - sizing, when passed `h`eight or `w`idth
 */
export const $u = UniversalHelper<M>;

/** @package animation helper */
export const $anim = Animate<M>;

/** @access parent
 * Helper to apply transforms to descendants. This is primarily for
 * working with content managed by third-party plugins outside of React,
 * e.g. animating equations rendered by KaTeX.
 */
export const $desc = TargetDescendants<M>;

/* -------------------- helper functions -------------------- */


/**
 * Reference the files in this project with type-safety.
 * @access parent
 */
export const projectFiles = new DirectoryHelper<ProjectDir, "projectPath">(
	process.env.NODE_ENV === "development"
		? `/api/liqvid/static/${projectPath}`
		: `${process.env.NEXT_PUBLIC_LIQVID_MEDIA_BASE}/${projectPath}`,
);

/**
 * Reference the files in the `.liqvid` directory of this project with type-safety.
 * @access parent
 */
export const assets = projectFiles.dir(".liqvid");
