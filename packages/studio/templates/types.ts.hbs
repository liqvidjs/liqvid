/** This file is automatically @generated. */
import type { FileNames{{#if hasChosenRecordings}}, Recording{{/if}} } from "@liqvid/studio";
{{#if hasChosenRecordings}}
import type { DurationString } from "@liqvid/utils";
{{/if}}

export type ProjectStructure =
{{#*inline "directoryTypes"}}
{
{{#each this}}
  {{json @key}}:
  {{#if (isDirectory this)}}
    {{> directoryTypes this}}
  {{else if this}}
    (() => {{{this}}})
  {{else}}
    (() => unknown)
  {{/if}}
  {{#unless @last}},{{/unless}}
{{/each}}
}
{{/inline}}
{{> directoryTypes directoryTypes}};

export type ProjectDir = FileNames<ProjectStructure>;

{{#if parameters.length}}
export type ProjectParams = {
{{#each parameters}}
  readonly {{this.name}}: {{#each this.values}}{{#unless @first}} | {{/unless}}"{{this}}"{{/each}};
{{/each}}
};
{{else}}
export type ProjectParams = Readonly<Record<string, never>>;
{{/if}}

{{#if chosenRecordings}}
/**
 * The recordings chosen for inclusion in the final video (the
 * `chosenRecordings` field of `.liqvid/project-meta.json`).
 *
 * Only the current parameter combination is populated at runtime, although
 * this type is typed as if every combination were assigned.
 */
export type ChosenRecordings = {{{chosenRecordings}}};
{{else}}
export type ChosenRecordings = Record<string, never>;
{{/if}}
