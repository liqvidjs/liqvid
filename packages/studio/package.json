{
  "name": "@liqvid/studio",
  "version": "1.0.0-alpha.6",
  "description": "Production suite for Liqvid videos",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.mts",
      "@liqvid/dev": "./src/index.mts",
      "import": "./dist/esm/index.mjs"
    },
    "./next/api": {
      "types": "./dist/types/next/api.d.mts",
      "@liqvid/dev": "./src/next/api.mts",
      "import": "./dist/esm/next/api.mjs"
    },
    "./next/page": {
      "types": "./dist/types/next/page.d.ts",
      "@liqvid/dev": "./src/next/page.tsx",
      "import": "./dist/esm/next/page.js"
    }
  },
  "scripts": {
    "build": "pnpm build:clean ; pnpm build:js ; pnpm build:hbs ; pnpm build:css ; pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:css": "rsync --include='*.css' --include='*/' --exclude='*' --recursive ./src/ ./dist/esm",
    "build:hbs": "cp -R templates dist",
    "build:js": "tsc",
    "build:postclean": "rm -f dist/tsconfig.tsbuildinfo",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:package": "../../format-package-json.sh",
    "test": "NODE_OPTIONS='--disable-warning=ExperimentalWarning --experimental-vm-modules' jest",
    "watch": "concurrently \"pnpm watch:css\" \"pnpm watch:hbs\" \"pnpm watch:tsc\"",
    "watch:css": "watch -n1 pnpm build:css",
    "watch:hbs": "watch -n1 pnpm build:hbs",
    "watch:tsc": "tsc --watch"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@phosphor-icons/react": "catalog:",
    "@radix-ui/react-portal": "catalog:",
    "chalk": "catalog:",
    "clsx": "catalog:",
    "execa": "catalog:",
    "handlebars": "catalog:",
    "http-status-codes": "catalog:",
    "lodash.debounce": "catalog:",
    "universal-cookie": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@jest/globals": "catalog:dev",
    "@types/jest": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "@types/react-dom": "catalog:dev",
    "@types/serve-handler": "catalog:dev",
    "concurrently": "catalog:dev",
    "jest": "catalog:dev",
    "next": "catalog:",
    "ts-jest": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/cli": "workspace:^2.0.0-alpha.0",
    "@liqvid/color-scheme": "workspace:^1.0.0-alpha.0",
    "@liqvid/duration": "workspace:^1.3.0",
    "@liqvid/event-emitter": "workspace:^1.0.0-alpha.0",
    "@liqvid/fp": "workspace:^1.0.0-alpha.0",
    "@liqvid/hydration": "workspace:^1.0.0-alpha.4",
    "@liqvid/iframe-api": "workspace:^1.0.0-alpha.0",
    "@liqvid/keymap": "workspace:^2.0.0-alpha.0",
    "@liqvid/playback": "workspace:^2.0.0-alpha.0",
    "@liqvid/player": "workspace:^1.0.0-alpha.1",
    "@liqvid/recording": "workspace:^1.0.0-alpha.0",
    "@liqvid/schemas": "workspace:^1.0.0-alpha.0",
    "@liqvid/ssr": "workspace:^1.0.0-alpha.0",
    "@liqvid/studio-plugin-api": "workspace:^1.0.0-alpha.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.0",
    "nodejs-whisper": "catalog:peer",
    "react": "catalog:peer",
    "serve-handler": "^6.1.7"
  },
  "sideEffects": false,
  "type": "module"
}
