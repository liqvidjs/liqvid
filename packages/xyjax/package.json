{
  "name": "@liqvid/xyjax",
  "version": "0.0.2",
  "description": "XyJax animation helpers for Liqvid",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/xyjax",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:js && pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "tsc; node ../../build.mjs; rollup -c",
    "build:postclean": "rm -rf dist/esm dist/types dist/tsconfig.tsbuildinfo",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:package": "../../format-package-json.sh"
  },
  "dependencies": {
    "@liqvid/utils": "workspace:^"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@liqvid/mathjax": "workspace:^",
    "@types/react": "catalog:dev",
    "liqvid": "workspace:^",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/playback": "workspace:^2.0.0-alpha.0",
    "@liqvid/mathjax": "workspace:^1.0.0-alpha.0",
    "react": "catalog:peer"
  },
  "keywords": [
    "liqvid",
    "mathjax",
    "xyjax"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  }
}
