{
  "name": "@lqv/playback",
  "version": "1.0.0-alpha.0",
  "description": "Playback interface for Liqvid-compatible plugins",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts"
    },
    "./react": {
      "@liqvid/dev": "./src/react.ts",
      "types": "./dist/types/react.d.ts",
      "import": "./dist/esm/react.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "test": "jest",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@testing-library/react": "catalog:dev",
    "@types/jest": "catalog:dev",
    "@types/react": "catalog:dev",
    "jest": "catalog:dev",
    "ts-jest": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  }
}
