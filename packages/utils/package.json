{
  "name": "@liqvid/utils",
  "version": "2.0.0-alpha.4",
  "description": "Utility functions for Liqvid",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/utils#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "pnpm build:clean; pnpm build:js; pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "tsc",
    "build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:package": "../../format-package-json.sh",
    "test": "jest --coverage",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "sharp": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/jest": "catalog:dev",
    "@types/react": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "jest": "catalog:dev",
    "ts-jest": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/duration": "workspace:^1.3.0",
    "@types/react": "catalog:peer",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "type": "module",
  "types": "dist/types/index.d.ts"
}
