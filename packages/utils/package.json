{
  "name": "@liqvid/utils",
  "version": "2.0.0-alpha.3",
  "description": "Utility functions for Liqvid",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "pnpm build:clean; pnpm build:js; pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "pnpm build:js:esm; pnpm build:js:cjs",
    "build:js:esm": "tsc",
    "build:js:cjs": "tsc --module commonjs --moduleResolution node --outDir dist/cjs --customConditions null --verbatimModuleSyntax false",
    "build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "biome check --fix",
    "test": "jest --coverage",
    "watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/utils#readme",
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/jest": "catalog:dev",
    "@types/react": "catalog:dev",
    "jest": "catalog:dev",
    "ts-jest": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/duration": "workspace:^1.3.0",
    "@types/react": "catalog:peer",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "type": "module"
}
