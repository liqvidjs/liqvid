    "./src/misc.ts",
    "./src/react.tsx",
    "./src/replay-data.ts",
    "./src/svg.ts",
    "./src/time.ts",
    "./src/types.ts"
  ],
  "out": "./docs",
  "plugin": ["../docs/typedoc-plugin.mts"]
}
