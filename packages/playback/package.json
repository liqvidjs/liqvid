{
  "name": "@liqvid/playback",
  "version": "2.0.0-alpha.2",
  "description": "Playback class for Liqvid",
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/playback#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid",
    "directory": "packages/playback"
  },
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "files": [
    "dist/*"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.mts",
      "@liqvid/dev": "./src/index.mts",
      "import": "./dist/esm/index.mjs"
    },
    "./react": {
      "types": "./dist/types/react.d.ts",
      "@liqvid/dev": "./src/react.tsx",
      "import": "./dist/esm/react.js"
    }
  },
  "scripts": {
    "build": "pnpm build:clean && pnpm build:js && pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "tsc",
    "build:postclean": "find . -name tsconfig.tsbuildinfo -delete",
    "docs:gen": "typedoc",
    "docs:watch": "typedoc --watch",
    "lint": "pnpm biome check --fix",
    "lint:package": "../../format-package-json.sh",
    "test": "jest",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "@lqv/playback": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/node": "catalog:dev",
    "@types/react": "catalog:dev",
    "babel-jest": "catalog:",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/duration": "workspace:^1.3.0",
    "@liqvid/event-emitter": "workspace:^1.0.0-alpha.0",
    "@liqvid/ssr": "workspace:^1.0.0-alpha.0",
    "@liqvid/studio-plugin-api": "workspace:^1.0.0-alpha.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.3",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "type": "module"
}
