{
  "name": "@liqvid/playback",
  "version": "2.0.0-alpha.1",
  "description": "Playback class for Liqvid",
  "exports": {
    ".": {
      "import": "./dist/esm/index.mjs",
      "types": "./dist/types/index.d.mts"
    },
    "./react": {
      "import": "./dist/esm/react.js",
      "types": "./dist/types/react.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "./dist/types/*"
      ]
    }
  },
  "files": [
    "dist/*"
  ],
  "scripts": {
    "build": "pnpm build:clean && pnpm build:js && pnpm build:postclean",
    "build:clean": "rm -rf dist",
    "build:js": "tsc",
    "build:postclean": "find . -name tsconfig.tsbuildinfo -delete",
    "lint": "pnpm biome check --fix",
    "test": "jest",
    "watch": "tsc --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/playback#readme",
  "dependencies": {
    "@lqv/playback": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "babel-jest": "catalog:",
    "tsd": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@liqvid/duration": "workspace:^1.3.0",
    "@liqvid/event-emitter": "workspace:^1.0.0-alpha.0",
    "@liqvid/ssr": "workspace:^1.0.0-alpha.0",
    "@liqvid/studio-plugin-api": "workspace:^1.0.0-alpha.0",
    "@liqvid/utils": "workspace:^2.0.0-alpha.3",
    "react": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "sideEffects": false,
  "type": "module"
}
