{
  "name": "@liqvid/schemas",
  "version": "1.0.0-alpha.0",
  "description": "Effect schemas and JSON Schema files for Liqvid",
  "homepage": "https://github.com/liqvidjs/liqvid/tree/main/packages/schemas#readme",
  "bugs": {
    "url": "https://github.com/liqvidjs/liqvid/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liqvidjs/liqvid.git"
  },
  "license": "MIT",
  "author": "Yuri Sulyma <yuri@liqvidjs.org>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@liqvid/dev": "./src/index.mts",
      "types": "./dist/types/index.d.mts",
      "import": "./dist/esm/index.mjs"
    }
  },
  "files": [
    "dist/*",
    "json-schemas/*"
  ],
  "scripts": {
    ".build:clean": "rm -rf dist",
    ".build:postclean": "rm dist/tsconfig.tsbuildinfo",
    "build": "tsc",
    "build:fresh": "pnpm .build:clean && pnpm build && pnpm .build:postclean",
    "generate:schemas": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/generate-schemas.mts && biome check --fix json-schemas",
    "lint": "biome check --fix",
    "lint:agent": "biome check --fix --reporter=concise",
    "lint:tsc": "tsc --noEmit",
    "watch": "tsc --watch"
  },
  "dependencies": {
    "effect-paths": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:dev",
    "@types/node": "catalog:dev",
    "@typescript/typescript6": "catalog:dev",
    "effect": "catalog:dev",
    "typedoc": "catalog:dev",
    "typedoc-plugin-markdown": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "peerDependencies": {
    "@liqvid/duration": "workspace:^1.4.0",
    "effect": "catalog:peer"
  },
  "peerDependenciesMeta": {
    "@liqvid/duration": {
      "optional": true
    },
    "effect": {
      "optional": true
    }
  }
}
