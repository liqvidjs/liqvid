{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?:[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$",
      "type": "string"
    },
    {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": ["NaN"],
              "type": "string"
            },
            {
              "enum": ["Infinity"],
              "type": "string"
            },
            {
              "enum": ["-Infinity"],
              "type": "string"
            }
          ]
        },
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": ["NaN"],
              "type": "string"
            },
            {
              "enum": ["Infinity"],
              "type": "string"
            },
            {
              "enum": ["-Infinity"],
              "type": "string"
            }
          ]
        }
      ],
      "type": "array"
    },
    {
      "additionalProperties": false,
      "properties": {
        "height": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": ["NaN"],
              "type": "string"
            },
            {
              "enum": ["Infinity"],
              "type": "string"
            },
            {
              "enum": ["-Infinity"],
              "type": "string"
            }
          ]
        },
        "width": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": ["NaN"],
              "type": "string"
            },
            {
              "enum": ["Infinity"],
              "type": "string"
            },
            {
              "enum": ["-Infinity"],
              "type": "string"
            }
          ]
        }
      },
      "required": ["height", "width"],
      "type": "object"
    }
  ]
}
