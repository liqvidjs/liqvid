{
  "$defs": {
    "Union_": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": ["Infinity", "-Infinity", "NaN"],
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?:[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$",
      "type": "string"
    },
    {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/Union_"
        },
        {
          "$ref": "#/$defs/Union_"
        }
      ],
      "type": "array"
    },
    {
      "additionalProperties": false,
      "properties": {
        "height": {
          "$ref": "#/$defs/Union_"
        },
        "width": {
          "$ref": "#/$defs/Union_"
        }
      },
      "required": ["height", "width"],
      "type": "object"
    }
  ]
}
