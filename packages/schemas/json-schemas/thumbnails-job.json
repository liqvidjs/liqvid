{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "colorScheme": {
      "description": "Color scheme",
      "enum": ["light", "dark", "both"],
      "type": "string"
    },
    "cols": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": ["Infinity", "-Infinity", "NaN"],
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "frequency": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": ["Infinity", "-Infinity", "NaN"],
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "height": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": ["Infinity", "-Infinity", "NaN"],
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "imageFormat": {
      "anyOf": [
        {
          "description": "Recognized image formats.",
          "enum": ["jpeg", "png"],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "jobId": {
      "type": "string"
    },
    "quality": {
      "anyOf": [
        {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "enum": ["Infinity", "-Infinity", "NaN"],
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "rows": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": ["Infinity", "-Infinity", "NaN"],
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": ["rendering", "completed", "failed"],
      "type": "string"
    },
    "width": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": ["Infinity", "-Infinity", "NaN"],
              "type": "string"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["colorScheme"],
  "type": "object"
}
