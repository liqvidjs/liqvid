{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "backend": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "enum": ["copy", "githubPages", "liqvidStudio", "s3", "sftp"],
          "type": "string"
        },
        "media": {
          "enum": ["copy", "liqvidStudio", "s3", "sftp"],
          "type": "string"
        }
      },
      "required": ["content", "media"],
      "type": "object"
    },
    "captioning": {
      "additionalProperties": false,
      "properties": {
        "nodeWhisperOptions": {
          "additionalProperties": false,
          "properties": {
            "autoDownloadModelName": {
              "enum": [
                "tiny",
                "tiny.en",
                "base",
                "base.en",
                "small",
                "small.en",
                "medium",
                "medium.en",
                "large-v1",
                "large",
                "large-v3-turbo"
              ],
              "type": "string"
            },
            "modelName": {
              "default": "base.en",
              "enum": [
                "tiny",
                "tiny.en",
                "base",
                "base.en",
                "small",
                "small.en",
                "medium",
                "medium.en",
                "large-v1",
                "large",
                "large-v3-turbo"
              ],
              "type": "string"
            },
            "modelRootPath": {
              "type": "string"
            },
            "timestampsLength": {
              "default": 20,
              "type": "number"
            },
            "translateToEnglish": {
              "default": false,
              "type": "boolean"
            },
            "withCuda": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": ["modelName"],
          "type": "object"
        }
      },
      "type": "object"
    },
    "providers": {
      "additionalProperties": false,
      "properties": {
        "bluesky": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "copy": {
          "additionalProperties": false,
          "properties": {
            "clean": {
              "default": false,
              "type": "boolean"
            },
            "destination": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "hosting": {
                      "type": "string"
                    },
                    "media": {
                      "type": "string"
                    }
                  },
                  "required": ["hosting", "media"],
                  "type": "object"
                }
              ]
            }
          },
          "required": ["destination"],
          "type": "object"
        },
        "facebook": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "githubPages": {
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "root": {
              "type": "boolean"
            },
            "username": {
              "type": "string"
            }
          },
          "required": ["repository", "username"],
          "type": "object"
        },
        "instagram": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "liqvidStudio": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "s3": {
          "additionalProperties": false,
          "properties": {
            "auth": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "profile": {
                      "type": "string"
                    },
                    "type": {
                      "const": "profile",
                      "type": "string"
                    }
                  },
                  "required": ["profile", "type"],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "accessKeyId": {
                      "default": "{env:AWS_ACCESS_KEY_ID}",
                      "pattern": "^\\{env:[\\s\\S]{0,}\\}$",
                      "type": "string"
                    },
                    "endpoint": {
                      "type": "string"
                    },
                    "region": {
                      "default": "us-east-1",
                      "type": "string"
                    },
                    "secretAccessKey": {
                      "default": "{env:AWS_SECRET_ACCESS_KEY}",
                      "pattern": "^\\{env:[\\s\\S]{0,}\\}$",
                      "type": "string"
                    },
                    "type": {
                      "const": "explicit",
                      "type": "string"
                    }
                  },
                  "required": [
                    "accessKeyId",
                    "region",
                    "secretAccessKey",
                    "type"
                  ],
                  "type": "object"
                }
              ]
            },
            "bucket": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "region": {
              "type": "string"
            }
          },
          "required": ["auth", "bucket", "domain"],
          "type": "object"
        },
        "sftp": {
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": ["host", "path"],
          "type": "object"
        },
        "twitter": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "youtube": {
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        }
      },
      "type": "object"
    },
    "publishing": {
      "additionalProperties": false,
      "properties": {
        "delete": {
          "default": false,
          "type": "boolean"
        },
        "include": {
          "additionalProperties": false,
          "properties": {
            "media": {
              "default": [
                "**/*.gif",
                "**/*.jpeg",
                "**/*.jpg",
                "**/*.m3u8",
                "**/*.mov",
                "**/*.mp4",
                "**/*.png",
                "**/*.webm",
                "!**/opengraph-image.*",
                "!**/twitter-image.*",
                "**/.liqvid/**/*.ts",
                "!**/.liqvid/types.ts",
                "!**/*.d.ts",
                "!**/*.d.json.ts"
              ],
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": ["media"],
          "type": "object"
        }
      },
      "required": ["delete"],
      "type": "object"
    }
  },
  "required": ["backend", "providers"],
  "type": "object"
}
