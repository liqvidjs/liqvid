{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "backend": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "enum": [
            "githubPages",
            "liqvidStudio",
            "s3",
            "sftp"
          ]
        },
        "media": {
          "type": "string",
          "enum": [
            "liqvidStudio",
            "s3",
            "sftp"
          ]
        }
      },
      "required": [
        "content",
        "media"
      ],
      "additionalProperties": false
    },
    "captioning": {
      "type": "object",
      "properties": {
        "nodeWhisperOptions": {
          "type": "object",
          "properties": {
            "autoDownloadModelName": {
              "type": "string"
            },
            "modelName": {
              "type": "string"
            },
            "modelRootPath": {
              "type": "string"
            },
            "timestamps_length": {
              "default": 20,
              "type": "number"
            },
            "withCuda": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "modelName",
            "withCuda"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "nodeWhisperOptions"
      ],
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "properties": {
        "bluesky": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": [
            "username"
          ],
          "additionalProperties": false
        },
        "facebook": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": [
            "username"
          ],
          "additionalProperties": false
        },
        "githubPages": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "root": {
              "type": "boolean"
            },
            "username": {
              "type": "string"
            }
          },
          "required": [
            "repository",
            "username"
          ],
          "additionalProperties": false
        },
        "instagram": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": [
            "username"
          ],
          "additionalProperties": false
        },
        "liqvidStudio": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": [
            "username"
          ],
          "additionalProperties": false
        },
        "s3": {
          "type": "object",
          "properties": {
            "auth": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "profile": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "const": "profile"
                    }
                  },
                  "required": [
                    "profile",
                    "type"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "accessKeyId": {
                      "default": "{env:AWS_ACCESS_KEY_ID}",
                      "type": "string",
                      "pattern": "^\\{env:[\\s\\S]{0,}\\}$"
                    },
                    "endpoint": {
                      "type": "string"
                    },
                    "region": {
                      "default": "us-east-1",
                      "type": "string"
                    },
                    "secretAccessKey": {
                      "default": "{env:AWS_SECRET_ACCESS_KEY}",
                      "type": "string",
                      "pattern": "^\\{env:[\\s\\S]{0,}\\}$"
                    },
                    "type": {
                      "type": "string",
                      "const": "explicit"
                    }
                  },
                  "required": [
                    "accessKeyId",
                    "region",
                    "secretAccessKey",
                    "type"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "bucket": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "region": {
              "type": "string"
            }
          },
          "required": [
            "auth",
            "bucket",
            "domain"
          ],
          "additionalProperties": false
        },
        "sftp": {
          "type": "object",
          "properties": {
            "host": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "host",
            "path"
          ],
          "additionalProperties": false
        },
        "twitter": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": [
            "username"
          ],
          "additionalProperties": false
        },
        "youtube": {
          "type": "object",
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": [
            "username"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "publishing": {
      "type": "object",
      "properties": {
        "delete": {
          "default": false,
          "type": "boolean"
        },
        "include": {
          "type": "object",
          "properties": {
            "media": {
              "default": [
                "**/*.gif",
                "**/*.jpeg",
                "**/*.jpg",
                "**/*.m3u8",
                "**/*.mov",
                "**/*.mp4",
                "**/*.png",
                "**/*.webm",
                "!**/opengraph-image.*",
                "!**/twitter-image.*",
                "**/.liqvid/**/*.ts",
                "!**/.liqvid/types.ts",
                "!**/*.d.ts",
                "!**/*.d.json.ts"
              ],
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "media"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "delete"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "backend",
    "captioning",
    "providers"
  ],
  "additionalProperties": false
}
