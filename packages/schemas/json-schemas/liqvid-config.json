{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "JSON schema path"
    },
    "backend": {
      "anyOf": [
        {
          "additionalProperties": true,
          "description": "Configure your hosting backends",
          "properties": {
            "content": {
              "anyOf": [
                {
                  "description": "Provider hosting your content files (html/css/js)",
                  "enum": ["copy", "githubPages", "liqvidStudio", "s3", "sftp"],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "media": {
              "anyOf": [
                {
                  "description": "Provider hosting your media files (audio, video, and thumbnails)",
                  "enum": ["copy", "liqvidStudio", "s3", "sftp"],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "basePath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "logging": {
      "anyOf": [
        {
          "additionalProperties": true,
          "description": "Logging configuration",
          "properties": {
            "level": {
              "anyOf": [
                {
                  "enum": ["debug", "info"],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "media": {
      "anyOf": [
        {
          "additionalProperties": true,
          "description": "Media config",
          "properties": {
            "audio": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "properties": {
                    "multiple": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "source": {
                      "description": "Whether to render from development preview or production build",
                      "enum": ["preview", "production"],
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "captioning": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "description": "Captioning configuration",
                  "properties": {
                    "smartWhisperOptions": {
                      "anyOf": [
                        {
                          "additionalProperties": true,
                          "properties": {
                            "gpu": {
                              "anyOf": [
                                {
                                  "type": "boolean"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "modelName": {
                              "anyOf": [
                                {
                                  "enum": [
                                    "tiny",
                                    "tiny.en",
                                    "base",
                                    "base.en",
                                    "small",
                                    "small.en",
                                    "medium",
                                    "medium.en",
                                    "large-v1",
                                    "large-v2",
                                    "large-v3",
                                    "large-v3-turbo"
                                  ],
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "modelPath": {
                              "anyOf": [
                                {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "string"
                                    }
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "description": "Explicit path to a ggml Whisper model file. When set, this takes precedence over modelName and no download occurs."
                            },
                            "translateToEnglish": {
                              "anyOf": [
                                {
                                  "type": "boolean"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "whisperOptions": {
                              "anyOf": [
                                {
                                  "additionalProperties": true,
                                  "properties": {
                                    "language": {
                                      "anyOf": [
                                        {
                                          "type": "string"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "maxLen": {
                                      "anyOf": [
                                        {
                                          "anyOf": [
                                            {
                                              "type": "number"
                                            },
                                            {
                                              "enum": [
                                                "Infinity",
                                                "-Infinity",
                                                "NaN"
                                              ],
                                              "type": "string"
                                            }
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "nThreads": {
                                      "anyOf": [
                                        {
                                          "anyOf": [
                                            {
                                              "type": "number"
                                            },
                                            {
                                              "enum": [
                                                "Infinity",
                                                "-Infinity",
                                                "NaN"
                                              ],
                                              "type": "string"
                                            }
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "description": "Number of threads to use for inference. If omitted, smart-whisper picks a sensible default."
                                    },
                                    "splitOnWord": {
                                      "anyOf": [
                                        {
                                          "type": "boolean"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "tokenTimestamps": {
                                      "anyOf": [
                                        {
                                          "type": "boolean"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "translate": {
                                      "anyOf": [
                                        {
                                          "type": "boolean"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    }
                                  },
                                  "type": "object"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "type": "object"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "renders": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "properties": {
                    "source": {
                      "description": "Whether to render from development preview or production build",
                      "enum": ["preview", "production"],
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "screenshots": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "properties": {
                    "source": {
                      "description": "Whether to render from development preview or production build",
                      "enum": ["preview", "production"],
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "thumbnails": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "description": "Thumbnail generation configuration",
                  "properties": {
                    "defaults": {
                      "additionalProperties": true,
                      "description": "Configuration for a thumbnail generation job",
                      "properties": {
                        "browserExecutable": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Path to browser executable (optional, will auto-detect)"
                        },
                        "browserHeight": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "enum": ["Infinity", "-Infinity", "NaN"],
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "browserWidth": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "enum": ["Infinity", "-Infinity", "NaN"],
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "colorScheme": {
                          "anyOf": [
                            {
                              "enum": ["light", "dark"],
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "cols": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "enum": ["Infinity", "-Infinity", "NaN"],
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "concurrency": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "enum": ["Infinity", "-Infinity", "NaN"],
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "frequency": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "enum": ["Infinity", "-Infinity", "NaN"],
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "height": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "enum": ["Infinity", "-Infinity", "NaN"],
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "imageFormat": {
                          "anyOf": [
                            {
                              "description": "Recognized image formats.",
                              "enum": ["jpeg", "png"],
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "quality": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "enum": ["Infinity", "-Infinity", "NaN"],
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "rows": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "enum": ["Infinity", "-Infinity", "NaN"],
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "width": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "enum": ["Infinity", "-Infinity", "NaN"],
                                  "type": "string"
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "type": "object"
                    },
                    "source": {
                      "description": "Whether to render from development preview or production build",
                      "enum": ["preview", "production"],
                      "type": "string"
                    }
                  },
                  "required": ["defaults"],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "providers": {
      "additionalProperties": true,
      "properties": {
        "copy": {
          "anyOf": [
            {
              "additionalProperties": true,
              "properties": {
                "clean": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "destination": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "additionalProperties": true,
                      "properties": {
                        "hosting": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string"
                            }
                          ]
                        },
                        "media": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      },
                      "required": ["hosting", "media"],
                      "type": "object"
                    }
                  ],
                  "description": "The destination to copy to. Can be either a directory path, or an object with separate paths for hosting vs media."
                },
                "domain": {
                  "anyOf": [
                    {
                      "format": "uri",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Domain content will be hosted at. Currently, this is only used for the \"copy embed code\" button."
                }
              },
              "required": ["destination"],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "githubPages": {
          "anyOf": [
            {
              "additionalProperties": true,
              "properties": {
                "repository": {
                  "type": "string"
                },
                "root": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "username": {
                  "type": "string"
                }
              },
              "required": ["repository", "username"],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "liqvidStudio": {
          "anyOf": [
            {
              "additionalProperties": true,
              "properties": {
                "username": {
                  "type": "string"
                }
              },
              "required": ["username"],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "s3": {
          "anyOf": [
            {
              "additionalProperties": true,
              "description": "Configuration for AWS S3 (or other compatible provider)",
              "properties": {
                "auth": {
                  "anyOf": [
                    {
                      "additionalProperties": true,
                      "description": "Authentication via AWS profile",
                      "properties": {
                        "profile": {
                          "type": "string"
                        },
                        "type": {
                          "enum": ["profile"],
                          "type": "string"
                        }
                      },
                      "required": ["profile", "type"],
                      "type": "object"
                    },
                    {
                      "additionalProperties": true,
                      "description": "Explicit S3 credentials authentication",
                      "properties": {
                        "accessKeyId": {
                          "anyOf": [
                            {
                              "pattern": "^\\{env:[\\s\\S]*?\\}$",
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "endpoint": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "region": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "secretAccessKey": {
                          "anyOf": [
                            {
                              "pattern": "^\\{env:[\\s\\S]*?\\}$",
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "type": {
                          "enum": ["explicit"],
                          "type": "string"
                        }
                      },
                      "required": ["type"],
                      "type": "object"
                    }
                  ],
                  "description": "S3 authentication config - discriminated union"
                },
                "bucket": {
                  "description": "Bucket name",
                  "type": "string"
                },
                "domain": {
                  "format": "uri",
                  "type": "string"
                },
                "prefix": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Prefix to apply to all content from this project"
                },
                "region": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": ["auth", "bucket", "domain"],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "sftp": {
          "anyOf": [
            {
              "additionalProperties": true,
              "properties": {
                "domain": {
                  "anyOf": [
                    {
                      "format": "uri",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Domain content will be hosted at. Currently, this is only used for the \"copy embed code\" button."
                },
                "host": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": ["host", "path"],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "publishing": {
      "anyOf": [
        {
          "additionalProperties": true,
          "description": "Publishing configuration",
          "properties": {
            "delete": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "include": {
              "anyOf": [
                {
                  "additionalProperties": true,
                  "description": "Glob patterns of files to include when publishing",
                  "properties": {
                    "media": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "items": {
                                "type": "string"
                              },
                              "type": "array"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "rootParameters": {
      "anyOf": [
        {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "description": "Root-level static parameters that apply to all projects. These are used as fallbacks when a project does not define its own parameters. Format: `{ parameterName: [value1, value2, ...] }`. Note: \"value\" is not permitted as a parameter name.",
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "ui": {
      "anyOf": [
        {
          "additionalProperties": true,
          "properties": {
            "locale": {
              "anyOf": [
                {
                  "enum": ["en", "fr", "es", "de", "zh"],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "theme": {
              "anyOf": [
                {
                  "enum": ["light", "dark", "system"],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["providers"],
  "type": "object"
}
