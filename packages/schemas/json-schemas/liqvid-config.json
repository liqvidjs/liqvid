{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "JSON schema path"
    },
    "backend": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "content": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "copy",
                    "githubPages",
                    "liqvidStudio",
                    "s3",
                    "sftp"
                  ],
                  "description": "Provider hosting your content files (html/css/js)"
                },
                {
                  "type": "null"
                }
              ]
            },
            "media": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "copy",
                    "liqvidStudio",
                    "s3",
                    "sftp"
                  ],
                  "description": "Provider hosting your media files (audio, video, and thumbnails)"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true,
          "description": "Configure your hosting backends"
        },
        {
          "type": "null"
        }
      ]
    },
    "logging": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "level": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "debug",
                    "info"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true,
          "description": "Logging configuration"
        },
        {
          "type": "null"
        }
      ]
    },
    "media": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "audio": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "multiple": {
                      "anyOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "preview",
                        "production"
                      ],
                      "description": "Whether to render from development preview or production build"
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "captioning": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "smartWhisperOptions": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "gpu": {
                              "anyOf": [
                                {
                                  "type": "boolean"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "modelName": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "enum": [
                                    "tiny",
                                    "tiny.en",
                                    "base",
                                    "base.en",
                                    "small",
                                    "small.en",
                                    "medium",
                                    "medium.en",
                                    "large-v1",
                                    "large-v2",
                                    "large-v3",
                                    "large-v3-turbo"
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "modelPath": {
                              "anyOf": [
                                {
                                  "anyOf": [
                                    {
                                      "type": "string"
                                    },
                                    {
                                      "type": "string"
                                    }
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ],
                              "description": "Explicit path to a ggml Whisper model file. When set, this takes precedence over modelName and no download occurs."
                            },
                            "translateToEnglish": {
                              "anyOf": [
                                {
                                  "type": "boolean"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "whisperOptions": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "properties": {
                                    "language": {
                                      "anyOf": [
                                        {
                                          "type": "string"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "maxLen": {
                                      "anyOf": [
                                        {
                                          "anyOf": [
                                            {
                                              "type": "number"
                                            },
                                            {
                                              "type": "string",
                                              "enum": [
                                                "Infinity",
                                                "-Infinity",
                                                "NaN"
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "nThreads": {
                                      "anyOf": [
                                        {
                                          "anyOf": [
                                            {
                                              "type": "number"
                                            },
                                            {
                                              "type": "string",
                                              "enum": [
                                                "Infinity",
                                                "-Infinity",
                                                "NaN"
                                              ]
                                            }
                                          ]
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ],
                                      "description": "Number of threads to use for inference. If omitted, smart-whisper picks a sensible default."
                                    },
                                    "splitOnWord": {
                                      "anyOf": [
                                        {
                                          "type": "boolean"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "tokenTimestamps": {
                                      "anyOf": [
                                        {
                                          "type": "boolean"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    },
                                    "translate": {
                                      "anyOf": [
                                        {
                                          "type": "boolean"
                                        },
                                        {
                                          "type": "null"
                                        }
                                      ]
                                    }
                                  },
                                  "additionalProperties": true
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "additionalProperties": true
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": true,
                  "description": "Captioning configuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "renders": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": [
                        "preview",
                        "production"
                      ],
                      "description": "Whether to render from development preview or production build"
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "screenshots": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": [
                        "preview",
                        "production"
                      ],
                      "description": "Whether to render from development preview or production build"
                    }
                  },
                  "additionalProperties": true
                },
                {
                  "type": "null"
                }
              ]
            },
            "thumbnails": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "defaults": {
                      "type": "object",
                      "properties": {
                        "browserExecutable": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ],
                          "description": "Path to browser executable (optional, will auto-detect)"
                        },
                        "browserHeight": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "browserWidth": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "colorScheme": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "light",
                                "dark"
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "cols": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "concurrency": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "frequency": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "height": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "imageFormat": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "jpeg",
                                "png"
                              ],
                              "description": "Recognized image formats."
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "quality": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "rows": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "width": {
                          "anyOf": [
                            {
                              "anyOf": [
                                {
                                  "type": "number"
                                },
                                {
                                  "type": "string",
                                  "enum": [
                                    "Infinity",
                                    "-Infinity",
                                    "NaN"
                                  ]
                                }
                              ]
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "additionalProperties": true,
                      "description": "Configuration for a thumbnail generation job"
                    },
                    "source": {
                      "type": "string",
                      "enum": [
                        "preview",
                        "production"
                      ],
                      "description": "Whether to render from development preview or production build"
                    }
                  },
                  "required": [
                    "defaults"
                  ],
                  "additionalProperties": true,
                  "description": "Thumbnail generation configuration"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true,
          "description": "Media config"
        },
        {
          "type": "null"
        }
      ]
    },
    "providers": {
      "type": "object",
      "properties": {
        "copy": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "basePath": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Base path that content is hosted under. Should match the basePath in your framework configuration."
                },
                "clean": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "destination": {
                  "anyOf": [
                    {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "string"
                        }
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "hosting": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string"
                            }
                          ]
                        },
                        "media": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "string"
                            }
                          ]
                        }
                      },
                      "required": [
                        "hosting",
                        "media"
                      ],
                      "additionalProperties": true
                    }
                  ],
                  "description": "The destination to copy to. Can be either a directory path, or an object with separate paths for hosting vs media."
                },
                "domain": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Domain content will be hosted at. Currently, this is only used for the \"copy embed code\" button."
                }
              },
              "required": [
                "destination"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "githubPages": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "branch": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "repository": {
                  "type": "string",
                  "description": "Name of the repository to publish to"
                },
                "username": {
                  "type": "string",
                  "description": "Your GitHub username"
                }
              },
              "required": [
                "repository",
                "username"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "liqvidStudio": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "accessToken": {
                  "type": "string"
                },
                "username": {
                  "type": "string",
                  "description": "Your Liqvid Studio username."
                },
                "workspace": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Name of this project, used to scope your content on Liqvid Studio.\nIf not set, defaults to `name` from `package.json`.\nMUST be set if the package.json `name` contains a slash."
                }
              },
              "required": [
                "accessToken",
                "username"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "s3": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "auth": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "profile": {
                          "type": "string"
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "profile"
                          ]
                        }
                      },
                      "required": [
                        "profile",
                        "type"
                      ],
                      "additionalProperties": true,
                      "description": "Authentication via AWS profile"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "accessKeyId": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^\\{env:[\\s\\S]*?\\}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "endpoint": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "region": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "secretAccessKey": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^\\{env:[\\s\\S]*?\\}$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "type": {
                          "type": "string",
                          "enum": [
                            "explicit"
                          ]
                        }
                      },
                      "required": [
                        "type"
                      ],
                      "additionalProperties": true,
                      "description": "Explicit S3 credentials authentication"
                    }
                  ],
                  "description": "S3 authentication config - discriminated union"
                },
                "bucket": {
                  "type": "string",
                  "description": "Bucket name"
                },
                "domain": {
                  "type": "string",
                  "format": "uri"
                },
                "prefix": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Prefix to apply to all content from this project"
                },
                "region": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "auth",
                "bucket",
                "domain"
              ],
              "additionalProperties": true,
              "description": "Configuration for AWS S3 (or other compatible provider)"
            },
            {
              "type": "null"
            }
          ]
        },
        "sftp": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "basePath": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Base path that content is hosted under. Should match the basePath in your framework configuration."
                },
                "domain": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uri"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Domain content will be hosted at. Currently, this is only used for the \"copy embed code\" button."
                },
                "host": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "required": [
                "host",
                "path"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "publishing": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "delete": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "include": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "media": {
                      "anyOf": [
                        {
                          "anyOf": [
                            {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "additionalProperties": true,
                  "description": "Glob patterns of files to include when publishing"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true,
          "description": "Publishing configuration"
        },
        {
          "type": "null"
        }
      ]
    },
    "rootParameters": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Root-level static parameters that apply to all projects. These are used as fallbacks when a project does not define its own parameters. Format: `{ parameterName: [value1, value2, ...] }`. Note: \"value\" is not permitted as a parameter name."
        },
        {
          "type": "null"
        }
      ]
    },
    "ui": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "hideProjects": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "locale": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "en",
                    "fr",
                    "es",
                    "de",
                    "zh"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "theme": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "light",
                    "dark",
                    "system"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "providers"
  ],
  "additionalProperties": true
}
