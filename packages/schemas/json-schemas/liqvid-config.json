{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "backend": {
      "properties": {
        "content": {
          "enum": ["copy", "githubPages", "liqvidStudio", "s3", "sftp"],
          "type": "string"
        },
        "media": {
          "enum": ["copy", "liqvidStudio", "s3", "sftp"],
          "type": "string"
        }
      },
      "required": ["content", "media"],
      "type": "object"
    },
    "basePath": {
      "type": "string"
    },
    "media": {
      "properties": {
        "captioning": {
          "properties": {
            "nodeWhisperOptions": {
              "properties": {
                "autoDownloadModelName": {
                  "enum": [
                    "tiny",
                    "tiny.en",
                    "base",
                    "base.en",
                    "small",
                    "small.en",
                    "medium",
                    "medium.en",
                    "large-v1",
                    "large",
                    "large-v3-turbo"
                  ],
                  "type": "string"
                },
                "modelName": {
                  "default": "base.en",
                  "enum": [
                    "tiny",
                    "tiny.en",
                    "base",
                    "base.en",
                    "small",
                    "small.en",
                    "medium",
                    "medium.en",
                    "large-v1",
                    "large",
                    "large-v3-turbo"
                  ],
                  "type": "string"
                },
                "modelRootPath": {
                  "type": "string"
                },
                "timestampsLength": {
                  "default": 20,
                  "type": "number"
                },
                "translateToEnglish": {
                  "default": false,
                  "type": "boolean"
                },
                "withCuda": {
                  "default": false,
                  "type": "boolean"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "thumbnails": {
          "properties": {
            "defaults": {
              "properties": {
                "browserExecutable": {
                  "type": "string"
                },
                "browserHeight": {
                  "type": "number"
                },
                "browserWidth": {
                  "type": "number"
                },
                "colorScheme": {
                  "default": "light",
                  "enum": ["light", "dark"],
                  "type": "string"
                },
                "cols": {
                  "default": 5,
                  "type": "number"
                },
                "concurrency": {
                  "default": 1,
                  "type": "number"
                },
                "frequency": {
                  "default": 4,
                  "type": "number"
                },
                "height": {
                  "default": 90,
                  "type": "number"
                },
                "imageFormat": {
                  "default": "png",
                  "enum": ["jpeg", "png"],
                  "type": "string"
                },
                "quality": {
                  "default": 80,
                  "type": "number"
                },
                "rows": {
                  "default": 5,
                  "type": "number"
                },
                "width": {
                  "default": 160,
                  "type": "number"
                }
              },
              "type": "object"
            }
          },
          "required": ["defaults"],
          "type": "object"
        }
      },
      "required": ["thumbnails"],
      "type": "object"
    },
    "providers": {
      "properties": {
        "bluesky": {
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "copy": {
          "properties": {
            "clean": {
              "default": false,
              "type": "boolean"
            },
            "destination": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "properties": {
                    "hosting": {
                      "type": "string"
                    },
                    "media": {
                      "type": "string"
                    }
                  },
                  "required": ["hosting", "media"],
                  "type": "object"
                }
              ]
            }
          },
          "required": ["destination"],
          "type": "object"
        },
        "facebook": {
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "githubPages": {
          "properties": {
            "repository": {
              "type": "string"
            },
            "root": {
              "type": "boolean"
            },
            "username": {
              "type": "string"
            }
          },
          "required": ["repository", "username"],
          "type": "object"
        },
        "instagram": {
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "liqvidStudio": {
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "s3": {
          "properties": {
            "auth": {
              "oneOf": [
                {
                  "properties": {
                    "profile": {
                      "type": "string"
                    },
                    "type": {
                      "const": "profile",
                      "type": "string"
                    }
                  },
                  "required": ["profile", "type"],
                  "type": "object"
                },
                {
                  "properties": {
                    "accessKeyId": {
                      "default": "{env:AWS_ACCESS_KEY_ID}",
                      "pattern": "^\\{env:[\\s\\S]{0,}\\}$",
                      "type": "string"
                    },
                    "endpoint": {
                      "type": "string"
                    },
                    "region": {
                      "default": "us-east-1",
                      "type": "string"
                    },
                    "secretAccessKey": {
                      "default": "{env:AWS_SECRET_ACCESS_KEY}",
                      "pattern": "^\\{env:[\\s\\S]{0,}\\}$",
                      "type": "string"
                    },
                    "type": {
                      "const": "explicit",
                      "type": "string"
                    }
                  },
                  "required": ["type"],
                  "type": "object"
                }
              ]
            },
            "bucket": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "region": {
              "type": "string"
            }
          },
          "required": ["auth", "bucket", "domain"],
          "type": "object"
        },
        "sftp": {
          "properties": {
            "host": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": ["host", "path"],
          "type": "object"
        },
        "twitter": {
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        },
        "youtube": {
          "properties": {
            "username": {
              "type": "string"
            }
          },
          "required": ["username"],
          "type": "object"
        }
      },
      "type": "object"
    },
    "publishing": {
      "properties": {
        "delete": {
          "default": false,
          "type": "boolean"
        },
        "include": {
          "properties": {
            "media": {
              "default": [
                "**/*.gif",
                "**/*.jpeg",
                "**/*.jpg",
                "**/*.m3u8",
                "**/*.mov",
                "**/*.mp4",
                "**/*.png",
                "**/*.webm",
                "!**/opengraph-image.*",
                "!**/twitter-image.*",
                "**/.liqvid/**/*.ts",
                "!**/.liqvid/types.ts",
                "!**/*.d.ts",
                "!**/*.d.json.ts"
              ],
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  },
  "required": ["backend", "providers"],
  "type": "object"
}
