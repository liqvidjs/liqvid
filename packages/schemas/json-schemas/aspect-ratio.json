{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "height": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": ["NaN"],
          "type": "string"
        },
        {
          "enum": ["Infinity"],
          "type": "string"
        },
        {
          "enum": ["-Infinity"],
          "type": "string"
        }
      ]
    },
    "width": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": ["NaN"],
          "type": "string"
        },
        {
          "enum": ["Infinity"],
          "type": "string"
        },
        {
          "enum": ["-Infinity"],
          "type": "string"
        }
      ]
    }
  },
  "required": ["height", "width"],
  "type": "object"
}
