{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created": {
      "type": "string"
    },
    "duration": {
      "additionalProperties": false,
      "properties": {
        "milliseconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "enum": ["NaN"],
              "type": "string"
            },
            {
              "enum": ["Infinity"],
              "type": "string"
            },
            {
              "enum": ["-Infinity"],
              "type": "string"
            }
          ]
        }
      },
      "required": ["milliseconds"],
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "plugins": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": ["created", "duration", "name", "plugins"],
  "type": "object"
}
