{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "aspectRatio": {
      "anyOf": [
        {
          "pattern": "^-?\\d+(?:\\.\\d+)?:-?\\d+(?:\\.\\d+)?$",
          "type": "string"
        },
        {
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "properties": {
            "height": {
              "type": "number"
            },
            "width": {
              "type": "number"
            }
          },
          "required": ["height", "width"],
          "type": "object"
        }
      ],
      "default": {
        "height": 9,
        "width": 16
      }
    },
    "name": {
      "type": "string"
    }
  },
  "required": ["name"],
  "type": "object"
}
