{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "aspectRatio": {
      "default": {
        "height": 9,
        "width": 16
      },
      "anyOf": [
        {
          "type": "string",
          "pattern": "^-?\\d+(?:\\.\\d+)?:-?\\d+(?:\\.\\d+)?$"
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "height": {
              "type": "number"
            },
            "width": {
              "type": "number"
            }
          },
          "required": [
            "height",
            "width"
          ],
          "additionalProperties": false
        }
      ]
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "aspectRatio",
    "name"
  ],
  "additionalProperties": false
}
