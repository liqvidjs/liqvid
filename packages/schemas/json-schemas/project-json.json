{
  "$defs": {
    "Union_": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "enum": ["Infinity", "-Infinity", "NaN"],
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "aspectRatio": {
      "anyOf": [
        {
          "anyOf": [
            {
              "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?:[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$",
              "type": "string"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "$ref": "#/$defs/Union_"
                },
                {
                  "$ref": "#/$defs/Union_"
                }
              ],
              "type": "array"
            },
            {
              "additionalProperties": false,
              "properties": {
                "height": {
                  "$ref": "#/$defs/Union_"
                },
                "width": {
                  "$ref": "#/$defs/Union_"
                }
              },
              "required": ["height", "width"],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "draft": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "description": "Set this to true to omit the project from the production build."
    },
    "name": {
      "type": "string"
    },
    "parameters": {
      "anyOf": [
        {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": ["name"],
  "type": "object"
}
