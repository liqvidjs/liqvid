{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "aspectRatio": {
      "anyOf": [
        {
          "anyOf": [
            {
              "enum": ["square"],
              "type": "string"
            },
            {
              "enum": ["video"],
              "type": "string"
            },
            {
              "pattern": "^[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?:[+-]?\\d*\\.?\\d+(?:[Ee][+-]?\\d+)?$",
              "type": "string"
            },
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "enum": ["Infinity", "-Infinity", "NaN"],
                      "type": "string"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "enum": ["Infinity", "-Infinity", "NaN"],
                      "type": "string"
                    }
                  ]
                }
              ],
              "type": "array"
            },
            {
              "additionalProperties": false,
              "properties": {
                "height": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "enum": ["Infinity", "-Infinity", "NaN"],
                      "type": "string"
                    }
                  ]
                },
                "width": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "enum": ["Infinity", "-Infinity", "NaN"],
                      "type": "string"
                    }
                  ]
                }
              },
              "required": ["height", "width"],
              "type": "object"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "description": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "allOf": [
                  {
                    "additionalProperties": {
                      "type": "string"
                    },
                    "type": "object"
                  }
                ],
                "properties": {
                  "value": {
                    "type": "string"
                  }
                },
                "required": ["value"],
                "type": "object"
              },
              "type": "array"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "draft": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "description": "Set this to true to omit the project from the production build."
    },
    "parameters": {
      "anyOf": [
        {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "allOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              }
            ],
            "properties": {
              "value": {
                "type": "string"
              }
            },
            "required": ["value"],
            "type": "object"
          },
          "type": "array"
        }
      ]
    }
  },
  "required": ["title"],
  "type": "object"
}
