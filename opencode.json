{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "amazon-bedrock",
        "effect": "deny"
      }
    ]
  },
  "formatter": {
    "prettier": {
      "disabled": true
    }
  },
  "mcp": {
    "servers": {
      "next-devtools": {
        "command": ["npx", "-y", "next-devtools-mcp@latest"],
        "type": "local"
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "./node_modules/.bin/biome *", "effect": "allow" },
    { "action": "shell", "resource": "./node_modules/.bin/tsc *", "effect": "allow" },
    { "action": "shell", "resource": "biome *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "cd *", "effect": "allow" },
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "*find* -delete*", "effect": "deny" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "eslint *", "effect": "allow" },
    { "action": "shell", "resource": "git *", "effect": "deny" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "node --version", "effect": "allow" },
    { "action": "shell", "resource": "node build-stylex.mjs *", "effect": "allow" },
    { "action": "shell", "resource": "npm *", "effect": "ask" },
    { "action": "shell", "resource": "npm list", "effect": "allow" },
    { "action": "shell", "resource": "npm run build *", "effect": "allow" },
    { "action": "shell", "resource": "npx biome *", "effect": "allow" },
    { "action": "shell", "resource": "npx jest *", "effect": "allow" },
    { "action": "shell", "resource": "npx tsc --noEmit *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm add *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm build *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm build:js", "effect": "allow" },
    { "action": "shell", "resource": "pnpm exec biome *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm exec tsc --noEmit *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm filter *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm format *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm generate:openapi *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm generate:schemas", "effect": "allow" },
    { "action": "shell", "resource": "pnpm info *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm install *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm lint *", "effect": "allow" },
    { "action": "shell", "resource": "pnpm lint:agent", "effect": "allow" },
    { "action": "shell", "resource": "pnpm lint:stylex", "effect": "allow" },
    { "action": "shell", "resource": "pnpm ls *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "pnpm validate-translations *",
      "effect": "allow"
    },
    { "action": "shell", "resource": "ripwire *", "effect": "allow" },
    { "action": "shell", "resource": "rg *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "deny" },
    {
      "action": "shell",
      "resource": "rm -f packages/studio/dev/*",
      "effect": "allow"
    },
    { "action": "shell", "resource": "sed *", "effect": "allow" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "tsc --noEmit *", "effect": "allow" },
    { "action": "shell", "resource": "uniq *", "effect": "allow" },
    { "action": "shell", "resource": "xargs *", "effect": "allow" }
  ],
  "providers": {
    "anthropic": {
      "models": {},
      "settings": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  }
}
