{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["amazon-bedrock"],
  "formatter": {
    "prettier": {
      "disabled": true
    }
  },
  "mcp": {
    "next-devtools": {
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "type": "local"
    }
  },
  "permission": {
    "external_directory": "deny",
    "bash": {
      "*": "ask",
      "cat *": "allow",
      "cd *": "allow",
      "echo *": "allow",
      "*find* -delete*": "deny",
      "find *": "allow",
      "eslint *": "allow",
      "git *": "deny",
      "grep *": "allow",
      "head *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "node --version": "allow",
      "node build-stylex.mjs *": "allow",
      "npm *": "ask",
      "npm list": "allow",
      "npm run build *": "allow",
      "npx biome *": "allow",
      "npx jest *": "allow",
      "npx tsc --noEmit *": "allow",
      "pnpm add *": "allow",
      "pnpm build *": "allow",
      "pnpm build:js": "allow",
      "pnpm exec biome *": "allow",
      "pnpm exec tsc --noEmit *": "allow",
      "pnpm filter *": "allow",
      "pnpm format *": "allow",
      "pnpm generate:openapi *": "allow",
      "pnpm generate:schemas": "allow",
      "pnpm info *": "allow",
      "pnpm install *": "allow",
      "pnpm lint *": "allow",
      "pnpm lint:agent": "allow",
      "pnpm lint:stylex": "allow",
      "pnpm ls *": "allow",
      "pnpm validate-translations *": "allow",
      "ripwire *": "allow",
      "rm *": "deny",
      "sed *": "allow",
      "sort *": "allow",
      "tail *": "allow",
      "tsc --noEmit *": "allow",
      "uniq *": "allow",
      "xargs *": "allow"
    }
  },
  "provider": {
    "anthropic": {
      "models": {},
      "options": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  }
}
