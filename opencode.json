{
  "$schema": "https://opencode.ai/config.json",
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "effect": "deny",
        "resource": "amazon-bedrock"
      }
    ]
  },
  "formatter": {
    "biome": {
      "disabled": false
    },
    "prettier": {
      "disabled": true
    }
  },
  "mcp": {
    "servers": {
      "next-devtools": {
        "command": ["npx", "-y", "next-devtools-mcp@latest"],
        "type": "local"
      }
    }
  },
  "permissions": [
    { "action": "external_directory", "effect": "deny", "resource": "*" },
    { "action": "shell", "effect": "ask", "resource": "*" },
    { "action": "chrome_devtools_*", "effect": "allow", "resource": "*" },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "./node_modules/.bin/biome *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "./node_modules/.bin/esbuild *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "./node_modules/.bin/jest *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "NODE_OPTIONS=* ./node_modules/.bin/jest *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "./node_modules/.bin/tsc *"
    },
    { "action": "shell", "effect": "allow", "resource": "biome *" },
    { "action": "shell", "effect": "allow", "resource": "cat *" },
    { "action": "shell", "effect": "allow", "resource": "cd *" },
    { "action": "shell", "effect": "allow", "resource": "cp *" },
    { "action": "shell", "effect": "allow", "resource": "diff *" },
    { "action": "shell", "effect": "allow", "resource": "echo *" },
    { "action": "shell", "effect": "allow", "resource": "exit *" },
    { "action": "shell", "effect": "deny", "resource": "*find* -delete*" },
    { "action": "shell", "effect": "allow", "resource": "find *" },
    { "action": "shell", "effect": "allow", "resource": "eslint *" },
    { "action": "shell", "effect": "allow", "resource": "ffprobe *" },
    { "action": "shell", "effect": "deny", "resource": "git *" },
    { "action": "shell", "effect": "allow", "resource": "git diff *" },
    { "action": "shell", "effect": "allow", "resource": "git log *" },
    { "action": "shell", "effect": "allow", "resource": "git status *" },
    { "action": "shell", "effect": "allow", "resource": "grep *" },
    { "action": "grep", "effect": "allow", "resource": "*" },
    { "action": "shell", "effect": "allow", "resource": "head *" },
    { "action": "shell", "effect": "allow", "resource": "ln *" },
    { "action": "shell", "effect": "allow", "resource": "ls *" },
    { "action": "shell", "effect": "allow", "resource": "mkdir *" },
    { "action": "shell", "effect": "allow", "resource": "node --version" },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "node build-stylex.mjs *"
    },
    { "action": "shell", "effect": "ask", "resource": "npm *" },
    { "action": "shell", "effect": "allow", "resource": "npm list" },
    { "action": "shell", "effect": "allow", "resource": "npm run build *" },
    { "action": "shell", "effect": "allow", "resource": "npx biome *" },
    { "action": "shell", "effect": "allow", "resource": "npx jest *" },
    { "action": "shell", "effect": "allow", "resource": "jest *" },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "NODE_OPTIONS=* jest *"
    },
    { "action": "shell", "effect": "allow", "resource": "pnpm exec jest *" },
    { "action": "shell", "effect": "allow", "resource": "npx tsc --noEmit *" },
    { "action": "shell", "effect": "allow", "resource": "pnpm add *" },
    { "action": "shell", "effect": "allow", "resource": "pnpm build *" },
    { "action": "shell", "effect": "allow", "resource": "pnpm build:js" },
    { "action": "shell", "effect": "allow", "resource": "pnpm exec biome *" },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "pnpm exec tsc --noEmit *"
    },
    { "action": "shell", "effect": "allow", "resource": "pnpm filter *" },
    { "action": "shell", "effect": "allow", "resource": "pnpm format *" },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "pnpm generate:openapi *"
    },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "pnpm generate:schemas"
    },
    { "action": "shell", "effect": "allow", "resource": "pnpm info *" },
    { "action": "shell", "effect": "allow", "resource": "pnpm install *" },
    { "action": "shell", "effect": "allow", "resource": "pnpm lint *" },
    { "action": "shell", "effect": "allow", "resource": "pnpm lint:agent" },
    { "action": "shell", "effect": "allow", "resource": "pnpm lint:stylex" },
    { "action": "shell", "effect": "allow", "resource": "pnpm ls *" },
    { "action": "shell", "effect": "allow", "resource": "pnpm test *" },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "pnpm validate-translations *"
    },
    { "action": "shell", "effect": "allow", "resource": "pwd *" },
    { "action": "shell", "effect": "allow", "resource": "ripwire *" },
    { "action": "shell", "effect": "allow", "resource": "rg *" },
    { "action": "shell", "effect": "deny", "resource": "rm *" },
    {
      "action": "shell",
      "effect": "allow",
      "resource": "rm -f packages/studio/dev/*"
    },
    { "action": "shell", "effect": "allow", "resource": "sed *" },
    { "action": "shell", "effect": "allow", "resource": "sips *" },
    { "action": "shell", "effect": "allow", "resource": "sort *" },
    { "action": "shell", "effect": "allow", "resource": "stat *" },
    { "action": "shell", "effect": "allow", "resource": "tail *" },
    { "action": "shell", "effect": "allow", "resource": "tsc --noEmit *" },
    { "action": "shell", "effect": "allow", "resource": "true *" },
    { "action": "shell", "effect": "allow", "resource": "which *" },
    { "action": "shell", "effect": "allow", "resource": "uniq *" },
    { "action": "shell", "effect": "allow", "resource": "xargs *" }
  ],
  "providers": {
    "anthropic": {
      "models": {},
      "settings": {
        "apiKey": "{env:ANTHROPIC_API_KEY}"
      }
    }
  },
  "watcher": {
    "ignore": ["node_modules/**", "dist/**", ".git/**"]
  }
}
