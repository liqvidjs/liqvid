{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "docs:gen": {
      "dependsOn": ["^docs:gen"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:package": {
      "dependsOn": ["^lint:package"]
    },
    "watch": {
      "cache": false,
      "persistent": true
    }
  }
}
