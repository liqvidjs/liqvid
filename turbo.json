{
  "$schema": "https://turborepo.dev/schema.json",
  "globalEnv": ["DEV", "MODE", "PROD", "SSR"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "docs:gen": {
      "dependsOn": ["^docs:gen"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "watch": {
      "cache": false,
      "persistent": true
    }
  }
}
