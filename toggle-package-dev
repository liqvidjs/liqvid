#!/usr/bin/env bash
set -euo pipefail

MODE="${1:-}"
PACKAGE="${2:-}"

if { [ "$MODE" != "development" ] && [ "$MODE" != "production" ]; } || [ "$#" -gt 2 ]; then
  echo "Usage: $0 <development|production> [package]" >&2
  exit 1
fi

if [ "$MODE" = "development" ]; then
  FROM="@liqvid/dev"
  TO="default"
else
  FROM="default"
  TO="@liqvid/dev"
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -n "$PACKAGE" ]; then
  if [[ "$PACKAGE" == */* || "$PACKAGE" == "." || "$PACKAGE" == ".." ]]; then
    echo "Error: package must be a package directory name." >&2
    exit 1
  fi

  PACKAGE_FILE="$SCRIPT_DIR/packages/$PACKAGE/package.json"
  if [ ! -f "$PACKAGE_FILE" ]; then
    echo "Error: package '$PACKAGE' was not found in $SCRIPT_DIR/packages." >&2
    exit 1
  fi
  PACKAGE_FILES=("$PACKAGE_FILE")
else
  PACKAGE_FILES=("$SCRIPT_DIR"/packages/*/package.json)
fi

FILTER='
if (.exports | type) == "object" then
  .exports |= with_entries(
    .value |=
      if type == "object" then
        # rename $FROM -> $TO, then hoist $TO to be the first key
        (with_entries(if .key == $FROM then .key = $TO else . end)) as $renamed
        | ({($TO): $renamed[$TO]} + $renamed)
        | with_entries(select(.value != null))
      else . end
  )
else . end
'

for pkg in "${PACKAGE_FILES[@]}"; do
  [ -f "$pkg" ] || continue

  tmp="$(dirname "$pkg")/package-toggle.json"
  jq --arg FROM "$FROM" --arg TO "$TO" "$FILTER" "$pkg" >"$tmp"

  if [ -s "$tmp" ]; then
    mv "$tmp" "$pkg"
  else
    echo "Error: produced empty output for $pkg. Aborting." >&2
    rm -f "$tmp"
    exit 1
  fi
done

if [ -n "$PACKAGE" ]; then
  echo "Toggled package '$PACKAGE' to $MODE mode."
else
  echo "Toggled all packages to $MODE mode."
fi
